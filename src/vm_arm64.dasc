  |  add TMP1, BASE, RB, lsl #3
  |  ldr CARG1, [BASE, CARG4, lsl #3]
  |  checkint CARG1, >9
  |  sxtw CARG1, CARG1w
  |  ldr CARG3, [TMP1, #8]
  |  checkint CARG3, >9
