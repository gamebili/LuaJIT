  |  bne >9
  |  and TMP1w, TMP3w, #255
  |  ldr CARG2, [KBASE, TMP1, lsl #3]
  |  checkint CARG2, >9
  |  cmp CARG2w, #3
  |  bne >9
  |  ldrb TMP0w, [PC, #16+OFS_OP]
  |  cmp TMP0w, #BC_JMP
  |  bne >9
  |  ldrb TMP0w, [PC, #20+OFS_OP]
  |  cmp TMP0w, #BC_ADDVN
  |  bne >9
