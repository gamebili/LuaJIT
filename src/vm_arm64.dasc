  |  asr ITYPE, TMP0, #47
  |  cmn ITYPE, #-LJ_TINT64
  |   and TMP0, TMP0, #LJ_GCVMASK
  |  bne >9
  |  ldr TMP3, INT64:TMP0->owner
  |  add TMP2, BASE, CARG5, lsl #3
  |  cmp TMP2, TMP3
  |  bne >9
  |  ldr CARG2, INT64:TMP0->i
  |  ldrh TMP3w, [PC, #20+OFS_RD]
  |  ldr CARG4, [KBASE, TMP3, lsl #3]
  |  mov CARG5, CARG2
  |  mov CARG2, CARG4
  |  load_bitint64_2 >9
  |  mov CARG4, CARG2		// Loop mask.
  |  mov CARG2, CARG5		// Accumulator.
  |7:
  |  lsl TMP2, CARG1, #17
  |  lsr TMP3, CARG1, #3
  |  orr TMP2, TMP2, TMP3
  |  eor CARG2, CARG2, TMP2
  |  and CARG2, CARG2, CARG4
  |  add CARG1, CARG1, #1
  |  cmp CARG1w, CARG3w
  |  ble <7
  |  str CARG2, INT64:TMP0->i
