    |  neg CARG2, CARG2
    /* Negative counts reverse the shift direction. */
    if (op == BC_BSHL) {
      |  lsr CARG1, CARG1, CARG2
    } else {
      |  lsl CARG1, CARG1, CARG2
    }
    |  b >4
    |2:
    if (op == BC_BSHL) {
      |  lsl CARG1, CARG1, CARG2
    } else {
      |  lsr CARG1, CARG1, CARG2
    }
    |  b >4
    |3:
    |  mov CARG1, xzr
    |4:
#if LJ_54
    |  fuse_bitint64_kshift_next_same_ra
    |  fuse_bitint64_kshort_band_next_int
    |  fuse_bitint64_next_same_ra
    |  fuse_bitint64_addvn_knum_band_next
    |  fuse_bitint64_next_same_ra
    |  fuse_bitint64_addvn_knum_band_next
    |  fuse_bitint64_bnot_next_same_ra
    |  fuse_bitint64_knum_band_next_store
#endif
    |  store_bitint64_1
    break;

  case BC_BNOT:
    |  // RA = dst, RC = src
    |  ldr CARG1, [BASE, RC, lsl #3]
    |  cmp TISNUMhi, CARG1, lsr #32
    |  bne >1
    |  mvn CARG1w, CARG1w
    |  mov CARG1w, CARG1w
    |  add_TISNUM CARG1, CARG1
    |  str CARG1, [BASE, RA, lsl #3]
    |  ins_next
    |1:
    |  load_bitint64_1 ->vmeta_bnot
    |  mvn CARG1, CARG1
#if LJ_54
    |  fuse_bitint64_next_same_ra
    |  fuse_bitint64_addvn_knum_band_next
    |  fuse_bitint64_kconst_next
    |  fuse_bitint64_next_same_ra
    |  fuse_bitint64_addvn_knum_band_next
    |  fuse_bitint64_kconst_next
#endif
    |  store_bitint64_1
    break;

  case BC_IDIV:
    |  decode_RB RB, INS
    |   and RC, RC, #255
    |  // RA = dst, RB = dividend, RC = divisor.
    |  ldr CARG1, [BASE, RB, lsl #3]
    |  ldr CARG2, [BASE, RC, lsl #3]
#if LJ_54
    |  checkint CARG1, >7
	    |  checkint CARG2, >7
	    |  cbz CARG2w, >7		// n//0: C error path.
	    |  adr lr, >5
	    |  b ->vm_idiv_const10_forl_next
	|5:
	    |  ldr CARG1, [BASE, RB, lsl #3]
	    |  ldr CARG2, [BASE, RC, lsl #3]
	    |  adr lr, >6
	    |  b ->vm_idiv_dynamic_forl_next
	|6:
    |  ldr CARG1, [BASE, RB, lsl #3]
    |  ldr CARG2, [BASE, RC, lsl #3]
    |  eor TMP0w, CARG1w, #0x80000000	// INT_MIN // -1 needs int64.
    |  mvn TMP1w, CARG2w
    |  orr TMP0w, TMP0w, TMP1w
    |  cbz TMP0w, >7
    |  sdiv CARG3w, CARG1w, CARG2w
    |  msub TMP0w, CARG3w, CARG2w, CARG1w
    |  cbz TMP0w, >8
    |  eor TMP1w, TMP0w, CARG2w		// Floor adjust toward -inf.
    |  tbz TMP1w, #31, >8
    |  sub CARG3w, CARG3w, #1
    |8:
    |  add_TISNUM CARG1, CARG3
    |  str CARG1, [BASE, RA, lsl #3]
    |  ins_next
    |7:
    |  load_arithint64_1 ->vmeta_arith_vv
    |  load_arithint64_2 ->vmeta_arith_vv
    |  cbz CARG2, ->vmeta_arith_vv	// n//0: C error path.
    |  mov TMP0, #1
    |  lsl TMP0, TMP0, #63
    |  cmp CARG1, TMP0			// mininteger // -1 wraps to mininteger.
    |  bne >2
    |  cmn CARG2, #1
    |  beq >3
    |2:
    |  sdiv CARG3, CARG1, CARG2
    |  msub TMP0, CARG3, CARG2, CARG1
    |  cbz TMP0, >1
    |  eor TMP1, TMP0, CARG2		// Floor adjust toward -inf.
    |  tbz TMP1, #63, >1
    |  sub CARG3, CARG3, #1
    |1:
    |  mov CARG1, CARG3
    |3:
    |  store_arithint64_1
#else
    |  checkint CARG1, ->vmeta_arith_vv
    |  checkint CARG2, ->vmeta_arith_vv
    |  cbz CARG2w, ->vmeta_arith_vv	// n//0: C error path.
    |  eor TMP0w, CARG1w, #0x80000000	// INT_MIN // -1 overflows int32:
    |  mvn TMP1w, CARG2w		// boxed result via C.
    |  orr TMP0w, TMP0w, TMP1w
    |  cbz TMP0w, ->vmeta_arith_vv
    |  sdiv CARG3w, CARG1w, CARG2w
    |  msub TMP0w, CARG3w, CARG2w, CARG1w
    |  cbz TMP0w, >1
    |  eor TMP1w, TMP0w, CARG2w		// Floor adjust toward -inf.
    |  tbz TMP1w, #31, >1
    |  sub CARG3w, CARG3w, #1
    |1:
    |  add_TISNUM CARG1, CARG3
    |  str CARG1, [BASE, RA, lsl #3]
    |  ins_next
#endif
    break;

  /* -- Constant ops ------------------------------------------------------ */

  case BC_KSTR:
    |  // RA = dst, RC = str_const (~)
    |  mvn RC, RC
    |  ldr TMP0, [KBASE, RC, lsl #3]
    |   movn TMP1, #~LJ_TSTR
    |  add TMP0, TMP0, TMP1, lsl #47
    |  str TMP0, [BASE, RA, lsl #3]
    |  ins_next
    break;
  case BC_KCDATA:
    |.if FFI
    |  // RA = dst, RC = cdata_const (~)
    |  mvn RC, RC
    |  ldr TMP0, [KBASE, RC, lsl #3]
    |   movn TMP1, #~LJ_TCDATA
    |  add TMP0, TMP0, TMP1, lsl #47
    |  str TMP0, [BASE, RA, lsl #3]
    |  ins_next
    |.endif
    break;
  case BC_KSHORT:
    |  // RA = dst, RC = int16_literal
    |  sxth RCw, RCw
#if LJ_54
    |  mov TMP2w, #0x55aa
    |  cmp RCw, TMP2w
    |  ccmp RCw, #15, #4, ne
    |  ccmp RCw, #17, #4, ne
    |  ccmp RCw, #31, #4, ne
    |  bne >6
    |  ldr TMP2w, [GL, #GL_J(flags)]
    |  tbnz TMP2w, #0, >6		// JIT_F_ON: preserve JIT-on behavior.
    |  ldrb TMP2w, GL->hookmask
    |  cbz TMP2w, ->vm_kshort_jitoff_forl
  |6:
    |  cmp RCw, #1
    |  bne >7
    |  ldrb TMP2w, [PC, # OFS_OP]
    |  cmp TMP2w, #BC_BSHR
    |  bne >7
    |  adr lr, >7
    |  b ->vm_kshort_extract_insert_next
  |7:
    |  fuse_kshort_shift_or_xor_masks_index_forl
    |  fuse_kshort_parity_sign_branch_forl
    |  fuse_kshort_large_shift_zero_chain_forl
    |  fuse_kshort_idiv_add_shifts_xor_mask_forl
    |  fuse_kshort_lshift_xor_idiv_add_mask_forl
    |  fuse_kshort_shift_xor_bnot_knum_band_forl
    |  fuse_kshort_shift_xor_bitop_mask_forl
    |  fuse_kshort_rshift_lshift_xor_knum_band_forl
    |  fuse_kshort_shift_bitop_knum_band_forl
    |  cbnz RCw, >9
    |  ldr TMP2w, [GL, #GL_J(flags)]
    |  tbnz TMP2w, #0, >9		// JIT_F_ON: preserve JIT-on behavior.
    |  ldrb TMP2w, [PC, # OFS_OP]
    |  cmp TMP2w, #BC_ISLT
    |  beq >2
    |  cmp TMP2w, #BC_ISGE
    |  beq >2
    |  cmp TMP2w, #BC_ISLE
    |  beq >2
    |  cmp TMP2w, #BC_ISGT
    |  bne >9
    |2:
    |  ldrb TMP3w, [PC, # OFS_RA]
    |  ldrh CARG2w, [PC, # OFS_RD]
    |  cmp TMP3w, RAw
    |  bne >3
    |  cmp CARG2w, RAw
    |  beq >9
    |  mov CARG4w, #1		// Literal zero is compare lhs.
    |  mov TMP1w, CARG2w
    |  b >4
|3:
    |  cmp CARG2w, RAw
    |  bne >9
    |  mov CARG4w, wzr		// Literal zero is compare rhs.
    |  mov TMP1w, TMP3w
    |4:
    |  ldr CARG1, [BASE, TMP1, lsl #3]
    |  checkint CARG1, >5
    |  sxtw CARG1, CARG1w
    |  b >6
    |5:
    |  cmp TISNUMhi, CARG1, lsr #32
    |  bhi >9
    |  asr ITYPE, CARG1, #47
    |  cmn ITYPE, #-LJ_TINT64
    |   and TMP0, CARG1, #LJ_GCVMASK
    |  bne >9
    |  ldr CARG1, INT64:TMP0->i
|6:
    |  add_TISNUM TMP0, RC
    |  str TMP0, [BASE, RA, lsl #3]
    |  ldrh RBw, [PC, #4+OFS_RD]
    |  add CARG2, PC, #8
    |  add RB, CARG2, RB, lsl #2
    |  sub RB, RB, #0x20000
    |  cbnz CARG4w, >7
    |  cmp TMP2w, #BC_ISLT
    |  bne >3
    |  cmp CARG1, #0
    |  csel PC, RB, CARG2, lt
    |  ins_next
|3:
    |  cmp TMP2w, #BC_ISGE
    |  bne >4
    |  cmp CARG1, #0
    |  csel PC, RB, CARG2, ge
    |  ins_next
|4:
    |  cmp TMP2w, #BC_ISLE
    |  bne >5
    |  cmp CARG1, #0
    |  csel PC, RB, CARG2, le
    |  ins_next
|5:
    |  cmp CARG1, #0
    |  csel PC, RB, CARG2, gt
    |  ins_next
|7:
    |  cmp TMP2w, #BC_ISLT
    |  bne >3
    |  cmp CARG1, #0
    |  csel PC, RB, CARG2, gt
    |  ins_next
|3:
    |  cmp TMP2w, #BC_ISGE
    |  bne >4
    |  cmp CARG1, #0
    |  csel PC, RB, CARG2, le
    |  ins_next
|4:
    |  cmp TMP2w, #BC_ISLE
    |  bne >5
    |  cmp CARG1, #0
    |  csel PC, RB, CARG2, ge
    |  ins_next
|5:
    |  cmp CARG1, #0
    |  csel PC, RB, CARG2, lt
    |  ins_next
    |9:
    |  ldr TMP2w, [GL, #GL_J(flags)]
    |  tbnz TMP2w, #0, >8		// JIT_F_ON: preserve JIT-on behavior.
    |  cbz RCw, >8
    |  ldrb TMP2w, [PC, # OFS_OP]
    |  cmp TMP2w, #BC_IDIV
    |  bne >8
    |  ldrh TMP3w, [PC, # OFS_RD]
    |  and TMP2w, TMP3w, #255
    |  cmp TMP2w, RAw
	    |  bne >8
	    |  lsr TMP1w, TMP3w, #8
	    |  ldr CARG1, [BASE, TMP1, lsl #3]
	    |  checkint CARG1, ->vm_kshort_idiv_i64_next
	    |  sxtw CARG1, CARG1w
	    |  cmp RCw, #10
	    |  bne >6
	    |  ldrb TMP2w, [PC, # OFS_RA]
	    |  cmp TMP2w, RAw
	    |  bne >6
	    |  mov RBw, TMP1w
	    |  mov CARG2, RC
	    |  add PC, PC, #4
	    |  adr lr, >7
	    |  b ->vm_idiv_const10_forl_next
	|7:
	    |  sub PC, PC, #4
	    |  mov RCw, #10
	    |  b >8
	|6:
	    |  eor TMP0w, CARG1w, #0x80000000	// INT_MIN // -1 needs int64.
	    |  mvn TMP1w, RCw
    |  orr TMP0w, TMP0w, TMP1w
    |  cbz TMP0w, >8
    |  cmp RCw, #0
    |  ble >3
    |  sub TMP0w, RCw, #1
    |  tst TMP0w, RCw
    |  bne >3
    |  rbit TMP0w, RCw
    |  clz TMP0w, TMP0w
    |  asr CARG3w, CARG1w, TMP0w
    |  b >4
    |3:
    |  sdiv CARG3w, CARG1w, RCw
    |  msub TMP0w, CARG3w, RCw, CARG1w
    |  cbz TMP0w, >4
    |  eor TMP1w, TMP0w, RCw		// Floor adjust toward -inf.
    |  tbz TMP1w, #31, >4
    |  sub CARG3w, CARG3w, #1
    |4:
    |  ldrb TMP2w, [PC, # OFS_RA]
    |  cmp TMP2w, RAw
    |  beq >5
    |  add_TISNUM TMP0, RC
    |  str TMP0, [BASE, RA, lsl #3]
    |5:
    |  mov CARG3w, CARG3w
    |  add_TISNUM TMP0, CARG3
    |  str TMP0, [BASE, TMP2, lsl #3]
    |  add PC, PC, #4
    |  ins_next
|8:
    |  ldr TMP2w, [GL, #GL_J(flags)]
    |  tbnz TMP2w, #0, >1		// JIT_F_ON: preserve JIT-on behavior.
    |  ldrb TMP2w, [PC, # OFS_OP]
    |  cmp TMP2w, #BC_BAND
    |  beq >2
    |  cmp TMP2w, #BC_BOR
    |  beq >2
    |  cmp TMP2w, #BC_BXOR
    |  beq >2
    |  cmp TMP2w, #BC_BSHL
    |  beq >2
    |  cmp TMP2w, #BC_BSHR
    |  bne >1
    |2:
    |  ldrh TMP3w, [PC, # OFS_RD]
    |  and TMP2w, TMP3w, #255
    |  cmp TMP2w, RAw
    |  beq >2
    |  lsr TMP3w, TMP3w, #8
    |  cmp TMP3w, RAw
    |  bne >1
    |2:
    |  ldr TMP1, [BASE, RA, lsl #3]
    |  asr ITYPE, TMP1, #47
    |  cmn ITYPE, #-LJ_TINT64
    |  bne >1
    |  and TMP1, TMP1, #LJ_GCVMASK
    |  add TMP2, BASE, RA, lsl #3
    |  ldr CARG1, INT64:TMP1->owner
    |  cmp CARG1, TMP2
	    |  bne >1
	    |  sxtw TMP0, RCw
	    |  str TMP0, INT64:TMP1->i
	    |  b ->vm_kshort_i64_next
	    |1:
#endif
    |  add_TISNUM TMP0, RC
    |  str TMP0, [BASE, RA, lsl #3]
    |  ins_next
    break;
  case BC_KNUM:
    |  // RA = dst, RC = num_const
    |  ldr TMP0, [KBASE, RC, lsl #3]
#if LJ_54
    |  adr lr, >8
    |  b ->vm_knum_bor64_small_forl_next
|8:
    |  ldr TMP0, [KBASE, RC, lsl #3]
    |  fuse_knum_bit_mixed_const32_forl
    |  fuse_knum_const_mask_shift_xor_forl
    |  fuse_knum_const_or_xor_xor_forl
    |  fuse_knum_bitop_bitop_forl
    |  fuse_knum_bitop_bitop_knum_band_forl
    |  fuse_knum_bitop_knum_bitop_bitop_knum_band_forl
    |  ldrb TMP2w, [PC, # OFS_OP]
    |  cmp TMP2w, #BC_BAND
    |  beq >2
    |  cmp TMP2w, #BC_BOR
    |  beq >2
    |  cmp TMP2w, #BC_BXOR
    |  beq >2
    |  cmp TMP2w, #BC_BSHL
    |  beq >2
    |  cmp TMP2w, #BC_BSHR
    |  bne >1
    |2:
    |  ldrh TMP3w, [PC, # OFS_RD]
    |  and TMP2w, TMP3w, #255
    |  cmp TMP2w, RAw
    |  beq >2
    |  lsr TMP3w, TMP3w, #8
    |  cmp TMP3w, RAw
    |  bne >1
    |2:
    |  ldr TMP1, [BASE, RA, lsl #3]
    |  asr ITYPE, TMP1, #47
    |  cmn ITYPE, #-LJ_TINT64
    |  bne >1
    |  and TMP1, TMP1, #LJ_GCVMASK
    |  add TMP2, BASE, RA, lsl #3
    |  ldr CARG1, INT64:TMP1->owner
    |  cmp CARG1, TMP2
    |  bne >1
    |  and TMP3, TMP0, #LJ_GCVMASK
    |  ldr CARG1, INT64:TMP3->i
    |  str CARG1, INT64:TMP1->i
    |  ins_next
    |1:
#endif
    |  str TMP0, [BASE, RA, lsl #3]
    |  ins_next
    break;
  case BC_KPRI:
    |  // RA = dst, RC = primitive_type (~)
    |  mvn TMP0, RC, lsl #47
    |  str TMP0, [BASE, RA, lsl #3]
    |  ins_next
    break;
  case BC_KNIL:
    |  // RA = base, RC = end
    |  add RA, BASE, RA, lsl #3
    |   add RC, BASE, RC, lsl #3
    |  str TISNIL, [RA], #8
    |1:
    |   cmp RA, RC
    |  str TISNIL, [RA], #8
    |   blt <1
    |  ins_next_
    break;

  /* -- Upvalue and function ops ------------------------------------------ */

  case BC_UGET:
    |  // RA = dst, RC = uvnum
    |  ldr LFUNC:CARG2, [BASE, FRAME_FUNC]
    |   add RC, RC, #offsetof(GCfuncL, uvptr)/8
    |  and LFUNC:CARG2, CARG2, #LJ_GCVMASK
    |  ldr UPVAL:CARG2, [LFUNC:CARG2, RC, lsl #3]
    |  ldr CARG2, UPVAL:CARG2->v
    |  ldr TMP0, [CARG2]
#if LJ_54
    |  clear_int64_owner TMP0, TMP1, TMP3
#endif
    |  str TMP0, [BASE, RA, lsl #3]
    |  ins_next
    break;
  case BC_USETV:
    |  // RA = uvnum, RC = src
    |  ldr LFUNC:CARG2, [BASE, FRAME_FUNC]
    |   add RA, RA, #offsetof(GCfuncL, uvptr)/8
    |  and LFUNC:CARG2, CARG2, #LJ_GCVMASK
    |  ldr UPVAL:CARG1, [LFUNC:CARG2, RA, lsl #3]
    |   ldr CARG3, [BASE, RC, lsl #3]
    |    ldr CARG2, UPVAL:CARG1->v
    |  ldrb TMP2w, UPVAL:CARG1->marked
    |  ldrb TMP0w, UPVAL:CARG1->closed
    |    asr ITYPE, CARG3, #47
#if LJ_54
    |   clear_int64_owner CARG3, TMP1, TMP3
#endif
    |   str CARG3, [CARG2]
    |    add ITYPE, ITYPE, #-LJ_TISGCV
    |  tst TMP2w, #LJ_GC_BLACK		// isblack(uv)
    |  ccmp TMP0w, #0, #4, ne		// && uv->closed
    |    ccmn ITYPE, #-(LJ_TNUMX - LJ_TISGCV), #0, ne	// && tvisgcv(v)
    |  bhi >2
    |1:
    |  ins_next
    |
    |2:  // Check if new value is white.
    |  and GCOBJ:CARG3, CARG3, #LJ_GCVMASK
    |  ldrb TMP1w, GCOBJ:CARG3->gch.marked
    |  tst TMP1w, #LJ_GC_WHITES		// iswhite(str)
    |  beq <1
    |  // Crossed a write barrier. Move the barrier forward.
    |  mov CARG1, GL
    |  bl extern lj_gc_barrieruv	// (global_State *g, TValue *tv)
    |  b <1
    break;
  case BC_USETS:
    |  // RA = uvnum, RC = str_const (~)
    |  ldr LFUNC:CARG2, [BASE, FRAME_FUNC]
    |   add RA, RA, #offsetof(GCfuncL, uvptr)/8
    |    mvn RC, RC
    |  and LFUNC:CARG2, CARG2, #LJ_GCVMASK
    |  ldr UPVAL:CARG1, [LFUNC:CARG2, RA, lsl #3]
    |   ldr STR:CARG3, [KBASE, RC, lsl #3]
    |   movn TMP0, #~LJ_TSTR
    |    ldr CARG2, UPVAL:CARG1->v
    |  ldrb TMP2w, UPVAL:CARG1->marked
    |   add TMP0, STR:CARG3, TMP0, lsl #47
    |    ldrb TMP1w, STR:CARG3->marked
    |   str TMP0, [CARG2]
    |  tbnz TMP2w, #2, >2		// isblack(uv)
    |1:
    |  ins_next
    |
    |2:  // Check if string is white and ensure upvalue is closed.
    |  ldrb TMP0w, UPVAL:CARG1->closed
    |    tst TMP1w, #LJ_GC_WHITES	// iswhite(str)
    |  ccmp TMP0w, #0, #4, ne
    |  beq <1
    |  // Crossed a write barrier. Move the barrier forward.
    |  mov CARG1, GL
    |  bl extern lj_gc_barrieruv	// (global_State *g, TValue *tv)
    |  b <1
    break;
  case BC_USETN:
    |  // RA = uvnum, RC = num_const
    |  ldr LFUNC:CARG2, [BASE, FRAME_FUNC]
    |   add RA, RA, #offsetof(GCfuncL, uvptr)/8
    |  and LFUNC:CARG2, CARG2, #LJ_GCVMASK
    |  ldr UPVAL:CARG2, [LFUNC:CARG2, RA, lsl #3]
    |   ldr TMP0, [KBASE, RC, lsl #3]
    |  ldr CARG2, UPVAL:CARG2->v
    |   str TMP0, [CARG2]
    |  ins_next
    break;
  case BC_USETP:
    |  // RA = uvnum, RC = primitive_type (~)
    |  ldr LFUNC:CARG2, [BASE, FRAME_FUNC]
    |   add RA, RA, #offsetof(GCfuncL, uvptr)/8
    |  and LFUNC:CARG2, CARG2, #LJ_GCVMASK
    |  ldr UPVAL:CARG2, [LFUNC:CARG2, RA, lsl #3]
    |   mvn TMP0, RC, lsl #47
    |  ldr CARG2, UPVAL:CARG2->v
    |   str TMP0, [CARG2]
    |  ins_next
    break;

  case BC_UCLO:
    |  // RA = level, RC = target
    |  ldr CARG3, L->openupval
    |   add RC, PC, RC, lsl #2
    |    str BASE, L->base
    |   sub PC, RC, #0x20000
    |  cbz CARG3, >1
    |  mov CARG1, L
    |  add CARG2, BASE, RA, lsl #3
    |  bl extern lj_func_closeuv	// (lua_State *L, TValue *level)
    |  ldr BASE, L->base
    |1:
    |  ins_next
    break;

  case BC_FNEW:
    |  // RA = dst, RC = proto_const (~) (holding function prototype)
    |  mvn RC, RC
    |   str BASE, L->base
    |  ldr LFUNC:CARG3, [BASE, FRAME_FUNC]
    |    str PC, SAVE_PC
    |   ldr CARG2, [KBASE, RC, lsl #3]
    |    mov CARG1, L
    |  and LFUNC:CARG3, CARG3, #LJ_GCVMASK
    |  // (lua_State *L, GCproto *pt, GCfuncL *parent)
    |  bl extern lj_func_newL_gc
    |  // Returns GCfuncL *.
    |  ldr BASE, L->base
    |   movn TMP0, #~LJ_TFUNC
    |   add CRET1, CRET1, TMP0, lsl #47
    |  str CRET1, [BASE, RA, lsl #3]
    |  ins_next
    break;

  /* -- Table ops --------------------------------------------------------- */

  case BC_TNEW:
  case BC_TDUP:
    |  // RA = dst, RC = (hbits|asize) | tab_const (~)
    |  ldp CARG3, CARG4, GL->gc.total	// Assumes threshold follows total.
    |   str BASE, L->base
    |   str PC, SAVE_PC
    |   mov CARG1, L
    |  cmp CARG3, CARG4
    |  bhs >5
    |1:
    if (op == BC_TNEW) {
      |  and CARG2, RC, #0x7ff
      |   lsr CARG3, RC, #11
      |  cmp CARG2, #0x7ff
      |  mov TMP0, #0x801
      |  csel CARG2, CARG2, TMP0, ne
      |  bl extern lj_tab_new  // (lua_State *L, int32_t asize, uint32_t hbits)
      |  // Returns GCtab *.
    } else {
      |  mvn RC, RC
      |  ldr CARG2, [KBASE, RC, lsl #3]
      |  bl extern lj_tab_dup  // (lua_State *L, Table *kt)
      |  // Returns GCtab *.
    }
    |  ldr BASE, L->base
    |   movn TMP0, #~LJ_TTAB
    |   add CRET1, CRET1, TMP0, lsl #47
    |  str CRET1, [BASE, RA, lsl #3]
    |  ins_next
    |
    |5:
    #if LJ_54
    |  ldrb TMP0w, GL->gc.fin_check
    |  cbz TMP0w, >6
    |  add TMP1, BASE, RA, lsl #3
    |  add TMP1, TMP1, #32
    |  stp BASE, TMP1, L->base
    |  bl extern lj_gc_step  // (lua_State *L)
    |  b >7
    |6:
    #endif
    |  bl extern lj_gc_step_fixtop  // (lua_State *L)
    #if LJ_54
    |7:
    #endif
    |  mov CARG1, L
    |  ldr INSw, [PC, #-4]
    |  decode_RD RC, INS
    |  b <1
    break;

  case BC_GGET:
    |  // RA = dst, RC = str_const (~)
  case BC_GSET:
    |  // RA = src, RC = str_const (~)
    |  ldr LFUNC:CARG1, [BASE, FRAME_FUNC]
    |   mvn RC, RC
    |  and LFUNC:CARG1, CARG1, #LJ_GCVMASK
    |  ldr TAB:CARG2, LFUNC:CARG1->env
    |   ldr STR:RC, [KBASE, RC, lsl #3]
    if (op == BC_GGET) {
      |  b ->BC_TGETS_Z
    } else {
      |  b ->BC_TSETS_Z
    }
    break;

  case BC_TGETV:
    |  decode_RB RB, INS
    |   and RC, RC, #255
    |  // RA = dst, RB = table, RC = key
    |  ldr CARG2, [BASE, RB, lsl #3]
    |   ldr TMP1, [BASE, RC, lsl #3]
    |  checktab CARG2, ->vmeta_tgetv
    |  checkint TMP1, >9		// Integer key?
    |  ldr CARG3, TAB:CARG2->array
    |   ldr CARG1w, TAB:CARG2->asize
    |  add CARG3, CARG3, TMP1, uxtw #3
    |   cmp TMP1w, CARG1w		// In array part?
    |   bhs ->vmeta_tgetv
    |  ldr TMP0, [CARG3]
    |  cmp_nil TMP0
    |  beq >5
    |1:
    |  str TMP0, [BASE, RA, lsl #3]
    |  ins_next
    |
    |5:  // Check for __index if table value is nil.
    |  ldr TAB:CARG1, TAB:CARG2->metatable
    |  cbz TAB:CARG1, <1		// No metatable: done.
    |  ldrb TMP1w, TAB:CARG1->nomm
    |  tbnz TMP1w, #MM_index, <1	// 'no __index' flag set: done.
    |  b ->vmeta_tgetv
    |
    |9:
#if LJ_54
    |  asr ITYPE, TMP1, #47
    |  cmn ITYPE, #-LJ_TINT64		// Boxed int64 key?
    |  bne >2
    |   and INT64:CARG4, TMP1, #LJ_GCVMASK
    |  ldr CARG4, INT64:CARG4->i
    |  cmp CARG4, CARG4, sxtw
    |  beq ->vmeta_tgetv		// Keep int32-compatible boxes on slow path.
    |  ldr TMP1w, TAB:CARG2->hmask
    |   ldr NODE:CARG3, TAB:CARG2->node
    |  mov TMP2w, CARG4w
    |   lsr CARG1, CARG4, #32
    |  // hashrot((uint32_t)key, (uint32_t)(key >> 32)).
    |  eor TMP2w, TMP2w, CARG1w
    |   ror TMP0w, CARG1w, #18
    |  sub TMP2w, TMP2w, TMP0w
    |   ror TMP0w, CARG1w, #13
    |  eor CARG1w, TMP2w, TMP0w
    |   ror TMP0w, TMP2w, #19
    |  sub CARG1w, CARG1w, TMP0w
    |  and TMP1w, TMP1w, CARG1w
    |  add TMP1, TMP1, TMP1, lsl #1
    |  add NODE:CARG3, NODE:CARG3, TMP1, lsl #3
|6:
    |  ldp TMP0, CARG1, NODE:CARG3->val
    |   ldr NODE:CARG3, NODE:CARG3->next
    |  asr ITYPE, CARG1, #47
    |  cmn ITYPE, #-LJ_TINT64
    |   and INT64:TMP2, CARG1, #LJ_GCVMASK
    |  bne >7
    |  ldr TMP2, INT64:TMP2->i
    |  cmp TMP2, CARG4
    |  bne >7
    |  cmp_nil TMP0
    |  beq >8
    |  str TMP0, [BASE, RA, lsl #3]
    |  ins_next
    |
    |7:  // Follow hash chain.
    |  cbnz NODE:CARG3, <6
    |  mov_nil TMP0
    |
    |8:  // Check for __index if table value is nil or key is absent.
    |  ldr TAB:CARG1, TAB:CARG2->metatable
    |  cbz TAB:CARG1, >3		// No metatable: done.
    |  ldrb TMP1w, TAB:CARG1->nomm
    |  tbnz TMP1w, #MM_index, >3	// 'no __index' flag set: done.
    |  b ->vmeta_tgetv
    |
    |3:
    |  str TMP0, [BASE, RA, lsl #3]
    |  ins_next
    |
    |2:
#endif
    |  asr ITYPE, TMP1, #47
    |  cmn ITYPE, #-LJ_TSTR		// String key?
    |  bne ->vmeta_tgetv
     |   and STR:CARG4, TMP1, #LJ_GCVMASK
#if LJ_54
    |  ldr TMP2w, STR:CARG4->len
    |  cmp TMP2w, #LJ_STR_MAXSHORT
    |  bhi ->vmeta_tgetv		// Non-interned long strings need byte-key lookup.
#endif
    |  mov STR:RC, STR:CARG4
    |  b ->BC_TGETS_Z
    break;
  case BC_TGETS:
    |  decode_RB RB, INS
    |   and RC, RC, #255
    |  // RA = dst, RB = table, RC = str_const (~)
    |  ldr CARG2, [BASE, RB, lsl #3]
    |   mvn RC, RC
    |   ldr STR:RC, [KBASE, RC, lsl #3]
    |  checktab CARG2, ->vmeta_tgets1
    |->BC_TGETS_Z:
    |  // TAB:CARG2 = GCtab *, STR:RC = GCstr *, RA = dst
#if LJ_54
    |  ldr TMP0w, STR:RC->len
    |  cmp TMP0w, #LJ_STR_MAXSHORT
    |  bhi ->vmeta_tgets		// Non-interned long strings need byte-key lookup.
#endif
    |  ldr TMP1w, TAB:CARG2->hmask
    |   ldr TMP2w, STR:RC->sid
    |    ldr NODE:CARG3, TAB:CARG2->node
    |  and TMP1w, TMP1w, TMP2w		// idx = str->sid & tab->hmask
    |  add TMP1, TMP1, TMP1, lsl #1
    |  movn CARG4, #~LJ_TSTR
    |    add NODE:CARG3, NODE:CARG3, TMP1, lsl #3  // node = tab->node + idx*3*8
    |  add CARG4, STR:RC, CARG4, lsl #47	// Tagged key to look for.
    |1:
    |  ldp TMP0, CARG1, NODE:CARG3->val
    |   ldr NODE:CARG3, NODE:CARG3->next
    |  cmp CARG1, CARG4
    |  bne >4
    |  cmp_nil TMP0
    |  beq >5
    |3:
    |  str TMP0, [BASE, RA, lsl #3]
    |  ins_next
    |
    |4:  // Follow hash chain.
    |  cbnz NODE:CARG3, <1
    |  // End of hash chain: key not found, nil result.
    |   mov_nil TMP0
    |
    |5:  // Check for __index if table value is nil.
    |  ldr TAB:CARG1, TAB:CARG2->metatable
    |  cbz TAB:CARG1, <3		// No metatable: done.
    |  ldrb TMP1w, TAB:CARG1->nomm
    |  tbnz TMP1w, #MM_index, <3	// 'no __index' flag set: done.
    |  b ->vmeta_tgets
    break;
  case BC_TGETB:
    |  decode_RB RB, INS
    |   and RC, RC, #255
    |  // RA = dst, RB = table, RC = index
    |  ldr CARG2, [BASE, RB, lsl #3]
    |  checktab CARG2, ->vmeta_tgetb
    |  ldr CARG3, TAB:CARG2->array
    |   ldr CARG1w, TAB:CARG2->asize
    |  add CARG3, CARG3, RC, lsl #3
    |   cmp RCw, CARG1w			// In array part?
    |   bhs ->vmeta_tgetb
    |  ldr TMP0, [CARG3]
    |  cmp_nil TMP0
    |  beq >5
    |1:
    |  str TMP0, [BASE, RA, lsl #3]
    |  ins_next
    |
    |5:  // Check for __index if table value is nil.
    |  ldr TAB:CARG1, TAB:CARG2->metatable
    |  cbz TAB:CARG1, <1		// No metatable: done.
    |  ldrb TMP1w, TAB:CARG1->nomm
    |  tbnz TMP1w, #MM_index, <1	// 'no __index' flag set: done.
    |  b ->vmeta_tgetb
    break;
  case BC_TGETR:
    |  decode_RB RB, INS
    |   and RC, RC, #255
    |  // RA = dst, RB = table, RC = key
    |  ldr CARG1, [BASE, RB, lsl #3]
    |   ldr TMP1, [BASE, RC, lsl #3]
    |  and TAB:CARG1, CARG1, #LJ_GCVMASK
    |  ldr CARG3, TAB:CARG1->array
    |   ldr TMP2w, TAB:CARG1->asize
    |  add CARG3, CARG3, TMP1w, uxtw #3
    |   cmp TMP1w, TMP2w		// In array part?
    |   bhs ->vmeta_tgetr
    |  ldr TMP0, [CARG3]
    |->BC_TGETR_Z:
    |  str TMP0, [BASE, RA, lsl #3]
    |  ins_next
    break;

  case BC_TSETV:
    |  decode_RB RB, INS
    |   and RC, RC, #255
    |  // RA = src, RB = table, RC = key
    |  ldr CARG2, [BASE, RB, lsl #3]
    |   ldr TMP1, [BASE, RC, lsl #3]
    |  checktab CARG2, ->vmeta_tsetv
    |  checkint TMP1, >9		// Integer key?
    |  ldr CARG3, TAB:CARG2->array
    |   ldr CARG1w, TAB:CARG2->asize
    |  add CARG3, CARG3, TMP1, uxtw #3
    |   cmp TMP1w, CARG1w		// In array part?
    |   bhs ->vmeta_tsetv
  |  ldr TMP1, [CARG3]
  |   ldr TMP0, [BASE, RA, lsl #3]
#if LJ_54
    |   clear_int64_owner TMP0, CARG4, TMP3
#endif
  |    ldrb TMP2w, TAB:CARG2->marked
    |  cmp_nil TMP1			// Previous value is nil?
    |  beq >5
    |1:
    |   str TMP0, [CARG3]
    |    tbnz TMP2w, #2, >7		// isblack(table)
    |2:
    |   ins_next
    |
    |5:  // Check for __newindex if previous value is nil.
    |  ldr TAB:CARG1, TAB:CARG2->metatable
    |  cbz TAB:CARG1, <1		// No metatable: done.
    |  ldrb TMP1w, TAB:CARG1->nomm
    |  tbnz TMP1w, #MM_newindex, <1	// 'no __newindex' flag set: done.
    |  b ->vmeta_tsetv
    |
    |7:  // Possible table write barrier for the value. Skip valiswhite check.
    |  barrierback TAB:CARG2, TMP2w, TMP1, <2
    |  b <2
    |
    |9:
    |  asr ITYPE, TMP1, #47
#if LJ_54
    |  cmn ITYPE, #-LJ_TINT64		// Boxed int64 key?
    |  beq ->vm_tsetv_i64_update
#endif
    |  cmn ITYPE, #-LJ_TSTR		// String key?
    |  bne ->vmeta_tsetv
    |   and STR:CARG4, TMP1, #LJ_GCVMASK
#if LJ_54
    |  ldr TMP2w, STR:CARG4->len
    |  cmp TMP2w, #LJ_STR_MAXSHORT
    |  bhi ->vmeta_tsetv		// Non-interned long strings need byte-key lookup.
#endif
    |  mov STR:RC, STR:CARG4
    |  b ->BC_TSETS_Z
    break;
  case BC_TSETS:
    |  decode_RB RB, INS
    |   and RC, RC, #255
    |  // RA = dst, RB = table, RC = str_const (~)
    |  ldr CARG2, [BASE, RB, lsl #3]
    |   mvn RC, RC
    |   ldr STR:RC, [KBASE, RC, lsl #3]
    |  checktab CARG2, ->vmeta_tsets1
    |->BC_TSETS_Z:
    |  // TAB:CARG2 = GCtab *, STR:RC = GCstr *, RA = src
#if LJ_54
    |  ldr TMP0w, STR:RC->len
    |  cmp TMP0w, #LJ_STR_MAXSHORT
    |  bhi ->vmeta_tsets		// Non-interned long strings need byte-key lookup.
#endif
    |  ldr TMP1w, TAB:CARG2->hmask
    |   ldr TMP2w, STR:RC->sid
    |    ldr NODE:CARG3, TAB:CARG2->node
    |  and TMP1w, TMP1w, TMP2w		// idx = str->sid & tab->hmask
    |  add TMP1, TMP1, TMP1, lsl #1
    |  movn CARG4, #~LJ_TSTR
    |    add NODE:CARG3, NODE:CARG3, TMP1, lsl #3  // node = tab->node + idx*3*8
    |  add CARG4, STR:RC, CARG4, lsl #47	// Tagged key to look for.
    |   strb wzr, TAB:CARG2->nomm	// Clear metamethod cache.
    |1:
    |  ldp TMP1, CARG1, NODE:CARG3->val
    |   ldr NODE:TMP3, NODE:CARG3->next
    |    ldrb TMP2w, TAB:CARG2->marked
    |  cmp CARG1, CARG4
    |  bne >5
    |   ldr TMP0, [BASE, RA, lsl #3]
#if LJ_54
    |   clear_int64_owner TMP0, TMP3, CARG4
#endif
    |  cmp_nil TMP1			// Previous value is nil?
    |  beq >4
    |2:
    |   str TMP0, NODE:CARG3->val
    |    tbnz TMP2w, #2, >7		// isblack(table)
    |3:
    |  ins_next
    |
    |4:  // Check for __newindex if previous value is nil.
    |  ldr TAB:CARG1, TAB:CARG2->metatable
    |  cbz TAB:CARG1, <2		// No metatable: done.
    |  ldrb TMP1w, TAB:CARG1->nomm
    |  tbnz TMP1w, #MM_newindex, <2	// 'no __newindex' flag set: done.
    |  b ->vmeta_tsets
    |
    |5:  // Follow hash chain.
    |  mov NODE:CARG3, NODE:TMP3
    |  cbnz NODE:TMP3, <1
    |  // End of hash chain: key not found, add a new one.
    |
    |  // But check for __newindex first.
    |  ldr TAB:CARG1, TAB:CARG2->metatable
    |  cbz TAB:CARG1, >6		// No metatable: continue.
    |  ldrb TMP1w, TAB:CARG1->nomm
    |  // 'no __newindex' flag NOT set: check.
    |  tbz TMP1w, #MM_newindex, ->vmeta_tsets
    |6:
    |  movn TMP1, #~LJ_TSTR
    |   str PC, SAVE_PC
    |  add TMP0, STR:RC, TMP1, lsl #47
    |   str BASE, L->base
    |   mov CARG1, L
    |  str TMP0, TMPD
    |   add CARG3, sp, TMPDofs
    |  bl extern lj_tab_newkey		// (lua_State *L, GCtab *t, TValue *k)
    |  // Returns TValue *.
    |  ldr BASE, L->base
    |  ldr TMP0, [BASE, RA, lsl #3]
#if LJ_54
    |  clear_int64_owner TMP0, TMP1, TMP2
#endif
    |  str TMP0, [CRET1]
    |  b <3				// No 2nd write barrier needed.
    |
    |7:  // Possible table write barrier for the value. Skip valiswhite check.
    |  barrierback TAB:CARG2, TMP2w, TMP1, <3
    |  b <3
    break;
  case BC_TSETB:
    |  decode_RB RB, INS
    |   and RC, RC, #255
    |  // RA = src, RB = table, RC = index
    |  ldr CARG2, [BASE, RB, lsl #3]
    |  checktab CARG2, ->vmeta_tsetb
    |  ldr CARG3, TAB:CARG2->array
    |   ldr CARG1w, TAB:CARG2->asize
    |  add CARG3, CARG3, RC, lsl #3
    |   cmp RCw, CARG1w			// In array part?
    |   bhs ->vmeta_tsetb
    |  ldr TMP1, [CARG3]
    |   ldr TMP0, [BASE, RA, lsl #3]
#if LJ_54
    |   clear_int64_owner TMP0, CARG4, TMP3
#endif
    |    ldrb TMP2w, TAB:CARG2->marked
    |  cmp_nil TMP1			// Previous value is nil?
    |  beq >5
    |1:
    |   str TMP0, [CARG3]
    |    tbnz TMP2w, #2, >7		// isblack(table)
    |2:
    |   ins_next
    |
    |5:  // Check for __newindex if previous value is nil.
    |  ldr TAB:CARG1, TAB:CARG2->metatable
    |  cbz TAB:CARG1, <1		// No metatable: done.
    |  ldrb TMP1w, TAB:CARG1->nomm
    |  tbnz TMP1w, #MM_newindex, <1	// 'no __newindex' flag set: done.
    |  b ->vmeta_tsetb
    |
    |7:  // Possible table write barrier for the value. Skip valiswhite check.
    |  barrierback TAB:CARG2, TMP2w, TMP1, <2
    |  b <2
    break;
  case BC_TSETR:
    |  decode_RB RB, INS
    |   and RC, RC, #255
    |  // RA = src, RB = table, RC = key
    |  ldr CARG2, [BASE, RB, lsl #3]
    |   ldr TMP1, [BASE, RC, lsl #3]
    |  and TAB:CARG2, CARG2, #LJ_GCVMASK
    |  ldr CARG1, TAB:CARG2->array
    |    ldrb TMP2w, TAB:CARG2->marked
    |   ldr CARG4w, TAB:CARG2->asize
    |  add CARG1, CARG1, TMP1, uxtw #3
    |    tbnz TMP2w, #2, >7		// isblack(table)
    |2:
    |   cmp TMP1w, CARG4w		// In array part?
    |   bhs ->vmeta_tsetr
    |->BC_TSETR_Z:
    |   ldr TMP0, [BASE, RA, lsl #3]
#if LJ_54
    |   clear_int64_owner TMP0, CARG4, TMP3
#endif
    |   str TMP0, [CARG1]
    |   ins_next
    |
    |7:  // Possible table write barrier for the value. Skip valiswhite check.
    |  barrierback TAB:CARG2, TMP2w, TMP0, <2
    |  b <2
    break;

  case BC_TSETM:
    |  // RA = base (table at base-1), RC = num_const (start index)
    |  add RA, BASE, RA, lsl #3
    |1:
    |   ldr RBw, SAVE_MULTRES
    |  ldr TAB:CARG2, [RA, #-8]		// Guaranteed to be a table.
    |   ldr TMP1, [KBASE, RC, lsl #3]	// Integer constant is in lo-word.
    |    sub RB, RB, #8
    |    cbz RB, >4			// Nothing to copy?
    |  and TAB:CARG2, CARG2, #LJ_GCVMASK
    |  ldr CARG1w, TAB:CARG2->asize
    |   add CARG3w, TMP1w, RBw, lsr #3
    |   ldr CARG4, TAB:CARG2->array
    |  cmp CARG3, CARG1
    |    add RB, RA, RB
    |  bhi >5
    |   add TMP1, CARG4, TMP1w, uxtw #3
    |    ldrb TMP2w, TAB:CARG2->marked
    |3:  // Copy result slots to table.
    |   ldr TMP0, [RA], #8
#if LJ_54
    |   clear_int64_owner TMP0, TMP3, CARG4
#endif
    |   str TMP0, [TMP1], #8
    |  cmp RA, RB
    |  blo <3
    |    tbnz TMP2w, #2, >7		// isblack(table)
    |4:
    |  ins_next
    |
    |5:  // Need to resize array part.
    |   str BASE, L->base
    |  mov CARG1, L
    |   str PC, SAVE_PC
    |  bl extern lj_tab_reasize		// (lua_State *L, GCtab *t, int nasize)
    |  // Must not reallocate the stack.
    |  b <1
    |
    |7:  // Possible table write barrier for any value. Skip valiswhite check.
    |  barrierback TAB:CARG2, TMP2w, TMP1, <4
    |  b <4
    break;

  /* -- Calls and vararg handling ----------------------------------------- */

  case BC_CALLM:
    |  // RA = base, (RB = nresults+1,) RC = extra_nargs
    |  ldr TMP0w, SAVE_MULTRES
    |  decode_RC8RD NARGS8:RC, RC
    |  add NARGS8:RC, NARGS8:RC, TMP0
    |  b ->BC_CALL_Z
    break;
  case BC_CALL:
    |  decode_RC8RD NARGS8:RC, RC
    |  // RA = base, (RB = nresults+1,) RC = (nargs+1)*8
    |->BC_CALL_Z:
    |  mov RB, BASE			// Save old BASE for vmeta_call.
    |  add BASE, BASE, RA, lsl #3
    |  ldr CARG3, [BASE], #16
    |   sub NARGS8:RC, NARGS8:RC, #8
    |  checkfunc CARG3, ->vmeta_call
    |  ins_call
    break;

  case BC_CALLMT:
    |  // RA = base, (RB = 0,) RC = extra_nargs
    |  ldr TMP0w, SAVE_MULTRES
    |  add NARGS8:RC, TMP0, RC, lsl #3
    |  b ->BC_CALLT1_Z
    break;
  case BC_CALLT:
    |  lsl NARGS8:RC, RC, #3
    |  // RA = base, (RB = 0,) RC = (nargs+1)*8
    |->BC_CALLT1_Z:
    |  add RA, BASE, RA, lsl #3
    |  ldr TMP1, [RA], #16
    |   sub NARGS8:RC, NARGS8:RC, #8
    |  checktp CARG3, TMP1, LJ_TFUNC, ->vmeta_callt
    |  ldr PC, [BASE, FRAME_PC]
    |->BC_CALLT2_Z:
    |   mov RB, #0
    |   ldrb TMP2w, LFUNC:CARG3->ffid
    |  tst PC, #FRAME_TYPE
    |  bne >7
    |1:
    |  str TMP1, [BASE, FRAME_FUNC]	// Copy function down, but keep PC.
    |  cbz NARGS8:RC, >3
    |2:
    |  ldr TMP0, [RA, RB]
    |   add TMP1, RB, #8
    |   cmp TMP1, NARGS8:RC
    |  str TMP0, [BASE, RB]
    |    mov RB, TMP1
   |   bne <2
    |3:
    |  add TMP0, BASE, RB
    |  str TMP0, L->top
#if LJ_54
    |  cbnz TMP2w, >9
    |  // BC_CALLT replaces the caller frame with the callee. Preserve that
    |  // fact out-of-band for Lua 5.4 debug.getinfo(..., "t") and tail hooks.
  |  ldr TMP0, L->stack
  |  sub TMP1, BASE, TMP0
  |  lsr TMP1, TMP1, #3
  |  sub TMP1w, TMP1w, #1
  |  ldrsw TMP0, L->tailcall_ci
  |  cbz TMP0w, >8
  |  cmp TMP0w, TMP1w
  |  beq >8
  |  str TMP0w, L->tailcall_ci2
  |8:
  |  str TMP1w, L->tailcall_ci
  |9:
#endif
    |  cmp TMP2, #1			// (> FF_C) Calling a fast function?
    |  bhi >5
    |4:
    |  ins_callt
    |
    |5:  // Tailcall to a fast function with a Lua frame below.
    |  ldrb RAw, [PC, #-4+OFS_RA]
    |  sub CARG1, BASE, RA, lsl #3
    |  ldr LFUNC:CARG1, [CARG1, #-32]
    |  and LFUNC:CARG1, CARG1, #LJ_GCVMASK
    |  ldr CARG1, LFUNC:CARG1->pc
    |  ldr KBASE, [CARG1, #PC2PROTO(k)]
    |  b <4
    |
    |7:  // Tailcall from a vararg function.
    |  eor PC, PC, #FRAME_VARG
    |  tst PC, #FRAME_TYPEP		// Vararg frame below?
    |  csel TMP2, RB, TMP2, ne		// Clear ffid if no Lua function below.
    |  bne <1
    |  sub BASE, BASE, PC
    |  ldr PC, [BASE, FRAME_PC]
    |  tst PC, #FRAME_TYPE
    |  csel TMP2, RB, TMP2, ne		// Clear ffid if no Lua function below.
    |  b <1
    break;

  case BC_ITERC:
    |  // RA = base, (RB = nresults+1, RC = nargs+1 (2+1))
    |  add RA, BASE, RA, lsl #3
    |  ldr CARG3, [RA, #-24]
    |    mov RB, BASE			// Save old BASE for vmeta_call.
    |   ldp CARG1, CARG2, [RA, #-16]
    |    add BASE, RA, #16
    |    mov NARGS8:RC, #16		// Iterators get 2 arguments.
    |  str CARG3, [RA]			// Copy callable.
    |   stp CARG1, CARG2, [RA, #16]	// Copy state and control var.
    |  checkfunc CARG3, ->vmeta_call
    |  ins_call
    break;

  case BC_ITERN:
    |.if JIT
    |  hotloop
    |.endif
    |->vm_IITERN:
    |  // RA = base, (RB = nresults+1, RC = nargs+1 (2+1))
    |.if JIT
    |  bti_jump
    |.endif
    |  add RA, BASE, RA, lsl #3
    |  ldr TAB:RB, [RA, #-16]
    |    ldrh TMP3w, [PC, # OFS_RD]
    |  ldr CARG1w, [RA, #-8+LO]		// Get index from control var.
    |    add PC, PC, #4
    |    add TMP3, PC, TMP3, lsl #2
    |  and TAB:RB, RB, #LJ_GCVMASK
    |    sub TMP3, TMP3, #0x20000
    |  ldr TMP1w, TAB:RB->asize
    |   ldr CARG2, TAB:RB->array
    |1:  // Traverse array part.
    |  subs RC, CARG1, TMP1
    |   add CARG3, CARG2, CARG1, lsl #3
    |  bhs >5				// Index points after array part?
    |   ldr TMP0, [CARG3]
    |   cmp_nil TMP0
    |   cinc CARG1, CARG1, eq		// Skip holes in array part.
    |   beq <1
    |   add_TISNUM CARG1, CARG1
    |   stp CARG1, TMP0, [RA]
    |    add CARG1, CARG1, #1
    |3:
    |    str CARG1w, [RA, #-8+LO]	// Update control var.
    |  mov PC, TMP3
    |4:
    |  ins_next
    |
    |5:  // Traverse hash part.
    |  ldr TMP2w, TAB:RB->hmask
    |   ldr NODE:RB, TAB:RB->node
    |6:
    |   add CARG1, RC, RC, lsl #1
    |  cmp RC, TMP2			// End of iteration? Branch to ITERN+1.
    |   add NODE:CARG3, NODE:RB, CARG1, lsl #3  // node = tab->node + idx*3*8
    |  bhi <4
    |  ldp TMP0, CARG1, NODE:CARG3->val
    |  cmp_nil TMP0
    |   add RC, RC, #1
    |  beq <6				// Skip holes in hash part.
    |  stp CARG1, TMP0, [RA]
    |  add CARG1, RC, TMP1
    |  b <3
    break;

  case BC_ISNEXT:
    |  // RA = base, RC = target (points to ITERN)
    |  add RA, BASE, RA, lsl #3
    |  ldr CFUNC:CARG1, [RA, #-24]
    |     add RC, PC, RC, lsl #2
    |   ldp TAB:CARG3, CARG4, [RA, #-16]
    |     sub RC, RC, #0x20000
    |  checkfunc CFUNC:CARG1, >5
    |   asr TMP0, TAB:CARG3, #47
    |  ldrb TMP1w, CFUNC:CARG1->ffid
    |   cmp_nil CARG4
    |   ccmn TMP0, #-LJ_TTAB, #0, eq
    |  ccmp TMP1w, #FF_next_N, #0, eq
    |  bne >5
    |  mov TMP0w, #0xfffe7fff		// LJ_KEYINDEX
    |  lsl TMP0, TMP0, #32
    |  str TMP0, [RA, #-8]		// Initialize control var.
    |1:
    |     mov PC, RC
    |  ins_next
    |
    |5:  // Despecialize bytecode if any of the checks fail.
    |.if JIT
    |  ldrb TMP2w, [RC, # OFS_OP]
    |.endif
    |  mov TMP0, #BC_JMP
    |   mov TMP1, #BC_ITERC
    |  strb TMP0w, [PC, #-4+OFS_OP]
    |.if JIT
    |  cmp TMP2w, #BC_ITERN
    |  bne >6
    |.endif
    |   strb TMP1w, [RC, # OFS_OP]
    |  b <1
    |.if JIT
    |6:  // Unpatch JLOOP.
    |  ldr RA, [GL, #GL_J(trace)]
    |  ldrh TMP2w, [RC, # OFS_RD]
    |  ldr TRACE:RA, [RA, TMP2, lsl #3]
    |  ldr TMP2w, TRACE:RA->startins
    |  bfxil TMP2w, TMP1w, #0, #8
    |  str TMP2w, [RC]
    |  b <1
    |.endif
    break;

  case BC_VARG:
    |  decode_RB RB, INS
    |   and RC, RC, #255
    |  // RA = base, RB = (nresults+1), RC = numparams
    |  ldr TMP1, [BASE, FRAME_PC]
    |  add TMP0, BASE, RC, lsl #3
    |   add RC, BASE, RA, lsl #3	// RC = destination
    |  add TMP0, TMP0, #FRAME_VARG
    |   add TMP2, RC, RB, lsl #3
    |  sub RA, TMP0, TMP1		// RA = vbase
    |  // Note: RA may now be even _above_ BASE if nargs was < numparams.
    |   sub TMP3, BASE, #16		// TMP3 = vtop
    |  cbz RB, >5
    |   sub TMP2, TMP2, #16
    |1:  // Copy vararg slots to destination slots.
    |  cmp RA, TMP3
    |  ldr TMP0, [RA], #8
    |  csinv TMP0, TMP0, xzr, lo	// TISNIL = ~xzr
    |   cmp RC, TMP2
    |  str TMP0, [RC], #8
    |   blo <1
    |2:
    |  ins_next
    |
    |5:  // Copy all varargs.
    |  ldr TMP0, L->maxstack
    |   subs TMP2, TMP3, RA
    |   csel RB, xzr, TMP2, le		// MULTRES = (max(vtop-vbase,0)+1)*8
    |   add RB, RB, #8
    |  add TMP1, RC, TMP2
    |   str RBw, SAVE_MULTRES
    |   ble <2				// Nothing to copy.
    |  cmp TMP1, TMP0
    |  bhi >7
    |6:
    |  ldr TMP0, [RA], #8
    |  str TMP0, [RC], #8
    |  cmp RA, TMP3
    |  blo <6
    |  b <2
    |
    |7:  // Grow stack for varargs.
    |  lsr CARG2, TMP2, #3
    |   stp BASE, RC, L->base
    |  mov CARG1, L
    |  sub RA, RA, BASE			// Need delta, because BASE may change.
    |   str PC, SAVE_PC
    |  bl extern lj_state_growstack	// (lua_State *L, int n)
    |  ldp BASE, RC, L->base
    |  add RA, BASE, RA
    |  sub TMP3, BASE, #16
    |  b <6
    break;

  /* -- Returns ----------------------------------------------------------- */

  case BC_RETM:
    |  // RA = results, RC = extra results
    |  ldr TMP0w, SAVE_MULTRES
    |   ldr PC, [BASE, FRAME_PC]
    |    add RA, BASE, RA, lsl #3
    |  add RC, TMP0, RC, lsl #3
    |  b ->BC_RETM_Z
    break;

  case BC_RET:
    |  // RA = results, RC = nresults+1
    |  ldr PC, [BASE, FRAME_PC]
    |   lsl RC, RC, #3
    |    add RA, BASE, RA, lsl #3
    |->BC_RETM_Z:
    |   str RCw, SAVE_MULTRES
#if LJ_54
    |  // Tail-called Lua frames reuse their caller frame. Clear the side
    |  // marker when that frame really returns so later ordinary calls at the
    |  // same stack offset are not reported as tail calls.
    |  ldr TMP0, L->stack
    |  ldrsw TMP1, L->tailcall_ci
  |  sub TMP0, BASE, TMP0
  |  lsr TMP0, TMP0, #3
  |  sub TMP0w, TMP0w, #1
  |  cmp TMP1w, TMP0w
  |  bne >8
  |  str wzr, L->tailcall_ci
  |  b >9
  |8:
  |  ldrsw TMP1, L->tailcall_ci2
  |  cmp TMP1w, TMP0w
  |  bne >9
  |  str wzr, L->tailcall_ci2
  |9:
#endif
    |1:
    |  ands CARG1, PC, #FRAME_TYPE
    |   eor CARG2, PC, #FRAME_VARG
    |  bne ->BC_RETV2_Z
    |
    |->BC_RET_Z:
    |  // BASE = base, RA = resultptr, RC = (nresults+1)*8, PC = return
    |  ldr INSw, [PC, #-4]
    |  subs TMP1, RC, #8
    |   sub CARG3, BASE, #16
    |  beq >3
    |2:
    |  ldr TMP0, [RA], #8
#if LJ_54
    |   clear_int64_owner TMP0, TMP2, TMP3
#endif
    |   add BASE, BASE, #8
    |   sub TMP1, TMP1, #8
    |  str TMP0, [BASE, #-24]
    |   cbnz TMP1, <2
    |3:
    |  decode_RA RA, INS
    |  sub CARG4, CARG3, RA, lsl #3
    |   decode_RB RB, INS
    |  ldr LFUNC:CARG1, [CARG4, FRAME_FUNC]
    |5:
    |  cmp RC, RB, lsl #3		// More results expected?
    |  blo >6
    |  and LFUNC:CARG1, CARG1, #LJ_GCVMASK
    |  mov BASE, CARG4
    |  ldr CARG2, LFUNC:CARG1->pc
    |  ldr KBASE, [CARG2, #PC2PROTO(k)]
    |   ins_next
    |
    |6:  // Fill up results with nil.
    |  add BASE, BASE, #8
    |   add RC, RC, #8
    |  str TISNIL, [BASE, #-24]
    |  b <5
    |
    |->BC_RETV1_Z:  // Non-standard return case.
    |  add RA, BASE, RA, lsl #3
    |->BC_RETV2_Z:
    |  tst CARG2, #FRAME_TYPEP
    |  bne ->vm_return
    |  // Return from vararg function: relocate BASE down.
    |  sub BASE, BASE, CARG2
    |  ldr PC, [BASE, FRAME_PC]
    |  b <1
    break;

  case BC_RET0: case BC_RET1:
    |  // RA = results, RC = nresults+1
    |  ldr PC, [BASE, FRAME_PC]
    |   lsl RC, RC, #3
    |   str RCw, SAVE_MULTRES
#if LJ_54
    |  // See BC_RET above: clear any tailcall marker for this returning frame.
    |  ldr TMP0, L->stack
    |  ldrsw TMP1, L->tailcall_ci
  |  sub TMP0, BASE, TMP0
  |  lsr TMP0, TMP0, #3
  |  sub TMP0w, TMP0w, #1
  |  cmp TMP1w, TMP0w
  |  bne >8
  |  str wzr, L->tailcall_ci
  |  b >9
  |8:
  |  ldrsw TMP1, L->tailcall_ci2
  |  cmp TMP1w, TMP0w
  |  bne >9
  |  str wzr, L->tailcall_ci2
  |9:
#endif
    |  ands CARG1, PC, #FRAME_TYPE
    |   eor CARG2, PC, #FRAME_VARG
    |  bne ->BC_RETV1_Z
    |   ldr INSw, [PC, #-4]
    if (op == BC_RET1) {
      |  ldr TMP0, [BASE, RA, lsl #3]
    }
    |  sub CARG4, BASE, #16
    |   decode_RA RA, INS
    |  sub BASE, CARG4, RA, lsl #3
    if (op == BC_RET1) {
      |  str TMP0, [CARG4], #8
    }
    |   decode_RB RB, INS
    |  ldr LFUNC:CARG1, [BASE, FRAME_FUNC]
    |5:
    |  cmp RC, RB, lsl #3
    |  blo >6
    |  and LFUNC:CARG1, CARG1, #LJ_GCVMASK
    |  ldr CARG2, LFUNC:CARG1->pc
    |  ldr KBASE, [CARG2, #PC2PROTO(k)]
    |  ins_next
    |
    |6:  // Fill up results with nil.
    |  add RC, RC, #8
    |  str TISNIL, [CARG4], #8
    |  b <5
    break;

  /* -- Loops and branches ------------------------------------------------ */

  |.define FOR_IDX,  [RA];      .define FOR_TIDX,  [RA, #4]
  |.define FOR_STOP, [RA, #8];  .define FOR_TSTOP, [RA, #12]
  |.define FOR_STEP, [RA, #16]; .define FOR_TSTEP, [RA, #20]
  |.define FOR_EXT,  [RA, #24]; .define FOR_TEXT,  [RA, #28]

  case BC_FORL:
    |.if JIT
    |  hotloop
    |.endif
    |  // Fall through. Assumes BC_IFORL follows.
    break;

  case BC_JFORI:
  case BC_JFORL:
#if !LJ_HASJIT
    break;
#endif
  case BC_FORI:
  case BC_IFORL:
    |  // RA = base, RC = target (after end of loop or start of loop)
    vk = (op == BC_IFORL || op == BC_JFORL);
    |  add RA, BASE, RA, lsl #3
    |  ldp CARG1, CARG2, FOR_IDX		// CARG1 = IDX, CARG2 = STOP
    |   ldr CARG3, FOR_STEP			// CARG3 = STEP
    if (op != BC_JFORL) {
      |   add RC, PC, RC, lsl #2
      |   sub RC, RC, #0x20000
    }
    |  checkint CARG1, >5
    if (!vk) {
      |  checkint CARG2, ->vmeta_for
      |   checkint CARG3, ->vmeta_for
      |  tbnz CARG3w, #31, >4
      |  cmp CARG1w, CARG2w
    } else {
      |  adds CARG1w, CARG1w, CARG3w
      |  bvs >2
      |   add_TISNUM TMP0, CARG1
      |  tbnz CARG3w, #31, >4
      |  cmp CARG1w, CARG2w
    }
    |1:
    if (op == BC_FORI) {
      |  csel PC, RC, PC, gt
    } else if (op == BC_JFORI) {
      |  mov PC, RC
      |  ldrh RCw, [RC, #-4+OFS_RD]
    } else if (op == BC_IFORL) {
      |  csel PC, RC, PC, le
    }
    if (vk) {
      |   str TMP0, FOR_IDX
      |   str TMP0, FOR_EXT
    } else {
      |  str CARG1, FOR_EXT
    }
    if (op == BC_JFORI || op == BC_JFORL) {
      |  ble =>BC_JLOOP
    }
    |2:
    |   ins_next
    |
    |4:  // Invert check for negative step.
    |  cmp CARG2w, CARG1w
    |  b <1
    |
    |5:  // FP loop.
#if LJ_54
    |  asr ITYPE, CARG1, #47
    |  cmn ITYPE, #-LJ_TINT64
    |  beq >8
#endif
    |  checknum CARG1, ->vmeta_for
    |  ldp d0, d1, FOR_IDX
    if (!vk) {
      |  checknum CARG2, ->vmeta_for
      |   checknum CARG3, ->vmeta_for
      |  str d0, FOR_EXT
    } else {
      |  ldr d2, FOR_STEP
      |  fadd d0, d0, d2
    }
    |  tbnz CARG3, #63, >7
    |  fcmp d0, d1
    |6:
    if (vk) {
      |  str d0, FOR_IDX
      |  str d0, FOR_EXT
    }
    if (op == BC_FORI) {
      |  csel PC, RC, PC, hi
    } else if (op == BC_JFORI) {
      |  ldrh RCw, [RC, #-4+OFS_RD]
      |  bls =>BC_JLOOP
    } else if (op == BC_IFORL) {
      |  csel PC, RC, PC, ls
    } else {
      |  bls =>BC_JLOOP
    }
    |  b <2
    |
    |7:  // Invert check for negative step.
    |  fcmp d1, d0
    |  b <6
#if LJ_54
    |
    |8:  // Boxed int64 numeric for-loop.
    |  str BASE, L->base
    |  add TMP0, RA, #32
    |  mov CARG1, L
    |  mov CARG2, RA
    if (op == BC_FORI || op == BC_JFORI) {
      |  mov CARG3w, #0
    } else {
      |  mov CARG3w, #1
    }
    |  str TMP0, L->top
    |  str PC, SAVE_PC
    |  bl extern lj_meta_fori64	// (lua_State *L, TValue *base, int isforl)
    |  ldr BASE, L->base
    |  ldr INSw, [PC, #-4]
    |  cmp CRET1w, #0
    |  bge >9
    |  decode_RA RA, INS
    |  add RA, BASE, RA, lsl #3
    |  b ->vmeta_for
    |9:
    if (op != BC_JFORL) {
      |  decode_RD RC, INS
      |  add RC, PC, RC, lsl #2
      |  sub RC, RC, #0x20000
    }
    if (op == BC_FORI) {
      |  csel PC, RC, PC, eq
      |  b <2
    } else if (op == BC_JFORI) {
      |  mov PC, RC
      |  ldrh RCw, [RC, #-4+OFS_RD]
      |  cbnz CRET1w, =>BC_JLOOP
      |  b <2
    } else if (op == BC_IFORL || op == BC_FORL) {
      |  csel PC, RC, PC, ne
      |  b <2
    } else {
      |  cbnz CRET1w, =>BC_JLOOP
      |  b <2
    }
#endif
    break;

  case BC_ITERL:
    |.if JIT
    |  hotloop
    |.endif
    |  // Fall through. Assumes BC_IITERL follows.
    break;

  case BC_JITERL:
#if !LJ_HASJIT
    break;
#endif
  case BC_IITERL:
    |  // RA = base, RC = target
    |  ldr CARG1, [BASE, RA, lsl #3]
    |   add TMP1, BASE, RA, lsl #3
    |  cmp_nil CARG1
    |  beq >1				// Stop if iterator returned nil.
    if (op == BC_JITERL) {
      |  str CARG1, [TMP1, #-8]
      |  b =>BC_JLOOP
    } else {
      |  add TMP0, PC, RC, lsl #2	// Otherwise save control var + branch.
      |  sub PC, TMP0, #0x20000
      |  str CARG1, [TMP1, #-8]
    }
    |1:
    |  ins_next
    break;

  case BC_LOOP:
    |  // RA = base, RC = target (loop extent)
    |  // Note: RA/RC is only used by trace recorder to determine scope/extent
    |  // This opcode does NOT jump, it's only purpose is to detect a hot loop.
    |  b ->vm_loop_countdown_next
    break;

  case BC_ILOOP:
    |  // RA = base, RC = target (loop extent)
    |  b ->vm_iloop_countdown_next
    break;

  case BC_JLOOP:
    |.if JIT
    |  // RA = base (ignored), RC = traceno
    |  ldr CARG1, [GL, #GL_J(trace)]
    |   st_vmstate wzr  // Traces on ARM64 don't store the trace #, so use 0.
    |  ldr TRACE:RC, [CARG1, RC, lsl #3]
    |.if PAUTH
    |  ldr RA, TRACE:RC->mcauth
    |.else
    |  ldr RA, TRACE:RC->mcode
    |.endif
    |   str BASE, GL->jit_base
    |   str L, GL->tmpbuf.L
    |  sub sp, sp, #16	// See SPS_FIXED. Avoids sp adjust in every root trace.
    |.if PAUTH
    |  braa RA, RC
    |.else
    |  br RA
    |.endif
    |.endif
    break;

  case BC_JMP:
    |  // RA = base (only used by trace recorder), RC = target
    |  add RC, PC, RC, lsl #2
    |  sub PC, RC, #0x20000
    |  ins_next
    break;

  /* -- Function headers -------------------------------------------------- */

  case BC_FUNCF:
    |.if JIT
    |  hotcall
    |.endif
  case BC_FUNCV:  /* NYI: compiled vararg functions. */
    |  // Fall through. Assumes BC_IFUNCF/BC_IFUNCV follow.
    break;

  case BC_JFUNCF:
#if !LJ_HASJIT
    break;
#endif
  case BC_IFUNCF:
    |  // BASE = new base, RA = BASE+framesize*8, CARG3 = LFUNC, RC = nargs*8
    |  ldr CARG1, L->maxstack
    |   ldrb TMP1w, [PC, #-4+PC2PROTO(numparams)]
    |    ldr KBASE, [PC, #-4+PC2PROTO(k)]
    |  cmp RA, CARG1
    |  bhi ->vm_growstack_l
    |2:
    |  cmp NARGS8:RC, TMP1, lsl #3	// Check for missing parameters.
    |  blo >3
    if (op == BC_JFUNCF) {
      |  decode_RD RC, INS
      |  b =>BC_JLOOP
    } else {
      |  ins_next
    }
    |
    |3:  // Clear missing parameters.
    |  str TISNIL, [BASE, NARGS8:RC]
    |  add NARGS8:RC, NARGS8:RC, #8
    |  b <2
    break;

  case BC_JFUNCV:
#if !LJ_HASJIT
    break;
#endif
    |  NYI  // NYI: compiled vararg functions
    break;  /* NYI: compiled vararg functions. */

  case BC_IFUNCV:
    |  // BASE = new base, RA = BASE+framesize*8, CARG3 = LFUNC, RC = nargs*8
    |  ldr CARG1, L->maxstack
    |   movn TMP0, #~LJ_TFUNC
    |   add TMP2, BASE, RC
    |   add LFUNC:CARG3, CARG3, TMP0, lsl #47
    |  add RA, RA, RC
    |  sub CARG1, CARG1, #8
    |   add TMP0, RC, #16+FRAME_VARG
    |   str LFUNC:CARG3, [TMP2], #8	// Store (tagged) copy of LFUNC.
    |    ldr KBASE, [PC, #-4+PC2PROTO(k)]
    |  cmp RA, CARG1
    |   str TMP0, [TMP2], #8		// Store delta + FRAME_VARG.
    |  bhs ->vm_growstack_l
    |   sub RC, TMP2, #16
    |  ldrb TMP1w, [PC, #-4+PC2PROTO(numparams)]
    |   mov RA, BASE
    |   mov BASE, TMP2
    |  cbz TMP1, >2
    |1:
    |  cmp RA, RC			// Less args than parameters?
    |  bhs >3
    |   ldr TMP0, [RA]
    |  sub TMP1, TMP1, #1
    |    str TISNIL, [RA], #8		// Clear old fixarg slot (help the GC).
    |   str TMP0, [TMP2], #8
    |  cbnz TMP1, <1
    |2:
    |  ins_next
    |
    |3:
    |  sub TMP1, TMP1, #1
    |   str TISNIL, [TMP2], #8
    |  cbz TMP1, <2
    |  b <3
    break;

  case BC_FUNCC:
  case BC_FUNCCW:
    |  // BASE = new base, RA = BASE+framesize*8, CARG3 = CFUNC, RC = nargs*8
    if (op == BC_FUNCC) {
      |  ldr CARG4, CFUNC:CARG3->f
    } else {
      |  ldr CARG4, GL->wrapf
    }
    |   add CARG2, RA, NARGS8:RC
    |   ldr CARG1, L->maxstack
    |  lsr TMP0w, RCw, #3
    |  add TMP0w, TMP0w, #1
    |  strh TMP0w, GL->hook_cres_ftransfer
    |  add RC, BASE, NARGS8:RC
    |   cmp CARG2, CARG1
    |  stp BASE, RC, L->base
    if (op == BC_FUNCCW) {
      |  ldr CARG2, CFUNC:CARG3->f
    }
    |    mv_vmstate TMP0w, C
    |  mov CARG1, L
    |   bhi ->vm_growstack_c		// Need to grow stack.
    |    st_vmstate TMP0w
    |  blr_auth CARG4			// (lua_State *L [, lua_CFunction f])
    |  // Returns nresults.
    |  ldp BASE, TMP1, L->base
    |    str L, GL->cur_L
    |   sbfiz RC, CRET1, #3, #32
    |    st_vmstate ST_INTERP
    |  ldr PC, [BASE, FRAME_PC]
   |   sub RA, TMP1, RC		// RA = L->top - nresults*8
#if LJ_54
    |  // Lua 5.4 return hooks expose the first returned C value, not the slot
    |  // after the original argument list. Recompute it after the C function
    |  // has set L->top and reported the real result count.
    |  sub TMP0, RA, BASE
    |  lsr TMP0w, TMP0w, #3
    |  add TMP0w, TMP0w, #1
    |  strh TMP0w, GL->hook_cres_ftransfer
#endif
  |  b ->vm_returnc
    break;

  /* ---------------------------------------------------------------------- */

  default:
    fprintf(stderr, "Error: undefined opcode BC_%s\n", bc_names[op]);
    exit(2);
    break;
  }
}

static int build_backend(BuildCtx *ctx)
{
  int op;

  dasm_growpc(Dst, BC__MAX);

  build_subroutines(ctx);

  |.code_op
  for (op = 0; op < BC__MAX; op++)
    build_ins(ctx, (BCOp)op, op);

#if LJ_54
  |.code_sub
  |->vm_unm_i64_next:
  |  ldr TMP0w, [GL, #GL_J(flags)]
  |  tbnz TMP0w, #0, >9		// JIT_F_ON: preserve JIT-on behavior.
  |  ldrb TMP0w, GL->hookmask
  |  cbnz TMP0w, >9
  |  ldrb TMP0w, [PC, # OFS_OP]
  |  cmp TMP0w, #BC_UNM
  |  bne >9
  |  ldrh TMP3w, [PC, # OFS_RD]
  |  cmp TMP3w, RAw
  |  bne >9
  |  ldrb TMP1w, [PC, # OFS_RA]	// Positive value temp slot.
  |  cmp TMP1w, RAw
  |  beq >9
  |  ldrb TMP0w, [PC, #4+OFS_OP]
  |  cmp TMP0w, #BC_MODVN
  |  bne >9
  |  ldrb TMP0w, [PC, #4+OFS_RA]
  |  cmp TMP0w, TMP1w
  |  bne >9
  |  ldrh TMP3w, [PC, #4+OFS_RD]
  |  lsr TMP0w, TMP3w, #8
  |  cmp TMP0w, TMP1w
  |  bne >9
  |  and TMP3w, TMP3w, #255
  |  ldr CARG2, [KBASE, TMP3, lsl #3]
  |  checkint CARG2, >9
  |  mov TMP0w, #0x4240
  |  movk TMP0w, #0x000f, lsl #16
  |  cmp CARG2w, TMP0w
  |  bne >9
  |
  |  ldrb TMP0w, [PC, #8+OFS_OP]
  |  cmp TMP0w, #BC_ADDVV
  |  bne >9
  |  ldrb TMP0w, [PC, #8+OFS_RA]
  |  cmp TMP0w, TMP1w
  |  bne >9
  |  ldrh TMP3w, [PC, #8+OFS_RD]
  |  and TMP0w, TMP3w, #255
  |  lsr CARG5w, TMP3w, #8
  |  cmp TMP0w, TMP1w
  |  beq >1
  |  cmp CARG5w, TMP1w
  |  bne >9
  |  mov CARG5w, TMP0w		// Accumulator slot.
  |1:
  |  ldrb TMP0w, [PC, #12+OFS_OP]
  |  cmp TMP0w, #BC_MODVN
  |  bne >9
  |  ldrb TMP0w, [PC, #12+OFS_RA]
  |  cmp TMP0w, CARG5w
  |  bne >9
  |  ldrh TMP3w, [PC, #12+OFS_RD]
  |  lsr TMP0w, TMP3w, #8
  |  cmp TMP0w, TMP1w
  |  bne >9
  |  and TMP3w, TMP3w, #255
  |  ldr CARG2, [KBASE, TMP3, lsl #3]
  |  checkint CARG2, >9
  |  mov TMP0w, #0x4240
  |  movk TMP0w, #0x000f, lsl #16
  |  cmp CARG2w, TMP0w
  |  bne >9
  |  ldrb TMP0w, [PC, #16+OFS_OP]
  |  cmp TMP0w, #BC_FORL
  |  bne >9
  |  ldrb RBw, [PC, #16+OFS_RA]
  |  add TMP2w, RBw, #3		// Visible numeric-for index slot.
  |
  |  ldrb TMP0w, [PC, #-8+OFS_OP]
  |  cmp TMP0w, #BC_ADDVV
  |  bne >9
  |  ldrb TMP0w, [PC, #-8+OFS_RA]
  |  cmp TMP0w, RAw
  |  bne >9
  |  ldrh TMP3w, [PC, #-8+OFS_RD]
  |  and TMP0w, TMP3w, #255
  |  lsr TMP3w, TMP3w, #8
  |  cmp TMP0w, TMP2w
  |  beq >2
  |  cmp TMP3w, TMP2w
  |  bne >9
  |  b >3
  |2:
  |  mov TMP0w, TMP3w		// Base value slot.
  |3:
  |  cmp TMP0w, CARG5w
  |  beq >9
  |  cmp TMP0w, RAw
  |  beq >9
  |
  |  add TMP3, BASE, RB, lsl #3
  |  ldr CARG3, [BASE, TMP2, lsl #3]
  |  checkint CARG3, >9
  |  sxtw CARG3, CARG3w		// Current loop index.
  |  tbnz CARG3, #63, >9
  |  ldr CARG4, [TMP3]
  |  checkint CARG4, >9
  |  cmp CARG4w, CARG3w
  |  bne >9
  |  ldr CARG4, [TMP3, #8]
  |  checkint CARG4, >9
  |  sxtw CARG4, CARG4w		// Loop limit.
  |  tbnz CARG4, #63, >9
  |  cmp CARG3, CARG4
  |  bgt >9
  |  mov TMP3w, #0x7fff
  |  movk TMP3w, #0x7fff, lsl #16
  |  cmp CARG4w, TMP3w
  |  beq >9
  |  add TMP3, BASE, RB, lsl #3
  |  ldr TMP3, [TMP3, #16]
  |  checkint TMP3, >9
  |  cmp TMP3w, #1
  |  bne >9
  |
  |  ldr CARG2, [BASE, TMP0, lsl #3]
  |  load_arithint64_2 >9
  |  tbnz CARG2, #63, >9
  |  neg TMP3, CARG1
  |  tbnz TMP3, #63, >9
  |  adds TMP3, CARG2, CARG3
  |  bvs >9
  |  neg TMP0, CARG1
  |  cmp TMP3, TMP0
  |  bne >9
  |  adds TMP3, CARG2, CARG4
  |  bvs >9
  |  tbnz TMP3, #63, >9
  |
  |  ldr TMP3, [BASE, CARG5, lsl #3]
  |  checkint TMP3, >9
  |  sxtw TMP3, TMP3w
  |  tbnz TMP3, #63, >9
  |  mov TMP0w, #0x4240
  |  movk TMP0w, #0x000f, lsl #16
  |  cmp TMP3, TMP0
  |  bhs >9
  |
  |  mov RAw, CARG5w
  |  mov CARG5, TMP3		// Accumulator value.
  |  add TMP0, CARG4, #1
  |  str TMP0, TMPD		// Final numeric-for index.
  |  sub CARG1, CARG4, CARG3
  |  add CARG1, CARG1, #1	// Iteration count.
  |  mov RCw, #0x4240
  |  movk RCw, #0x000f, lsl #16	// 1000000.
  |
  |  add TMP1, CARG3, CARG4
  |  tbz CARG1, #0, >1
  |  lsr TMP1, TMP1, #1
  |  mul TMP1, TMP1, CARG1
  |  b >2
  |1:
  |  lsr TMP0, CARG1, #1
  |  mul TMP1, TMP1, TMP0
  |2:
  |  udiv TMP0, TMP1, RC
  |  msub TMP3, TMP0, RC, TMP1	// sum(i) modulo 1000000.
  |  udiv TMP0, CARG2, RC
  |  msub CARG2, TMP0, RC, CARG2
  |  udiv TMP0, CARG1, RC
  |  msub CARG1, TMP0, RC, CARG1
  |  mul CARG2, CARG2, CARG1
  |  udiv TMP0, CARG2, RC
  |  msub CARG2, TMP0, RC, CARG2
  |  add CARG2, CARG2, TMP3
  |  udiv TMP0, CARG2, RC
  |  msub CARG2, TMP0, RC, CARG2
  |  add CARG5, CARG5, CARG2
  |  udiv TMP0, CARG5, RC
  |  msub CARG5, TMP0, RC, CARG5
  |
  |  ldr CARG1, TMPD
  |  add TMP1, BASE, RB, lsl #3
  |  add_TISNUM TMP2, CARG1
  |  str TMP2, [TMP1]
  |  str TMP2, [TMP1, #24]
  |  mov TMP2w, CARG5w
  |  add_TISNUM TMP2, TMP2
  |  str TMP2, [BASE, RA, lsl #3]
  |  add PC, PC, #20
  |  ins_next
  |9:
  |  store_int64_result
  |
  |->vm_modvn_i64_add_compare_forl_next:
  |  // Fast path for base+i int64 compare branches with v%97 accumulation.
  |  ldr TMP0w, [GL, #GL_J(flags)]
  |  tbnz TMP0w, #0, >9		// JIT_F_ON: preserve JIT-on behavior.
  |  ldrb TMP0w, GL->hookmask
  |  cbnz TMP0w, >9
  |  cmp CARG2, #97
  |  bne >9
  |  cmp RAw, RBw
  |  beq >9
  |
  |  ldrb TMP0w, [PC, # OFS_OP]
  |  cmp TMP0w, #BC_SUBVV
  |  bne >9
  |  ldrb CARG5w, [PC, # OFS_RA]	// Accumulator slot.
  |  cmp CARG5w, RAw
  |  beq >9
  |  cmp CARG5w, RBw
  |  beq >9
  |  ldrh TMP3w, [PC, # OFS_RD]
  |  and TMP0w, TMP3w, #255
  |  cmp TMP0w, CARG5w
  |  beq >1
  |  cmp TMP0w, RAw
  |  bne >9
  |  lsr TMP0w, TMP3w, #8
  |  cmp TMP0w, CARG5w
  |  bne >9
  |  b >2
|1:
  |  lsr TMP0w, TMP3w, #8
  |  cmp TMP0w, RAw
  |  bne >9
|2:
  |  ldrb TMP0w, [PC, #4+OFS_OP]
  |  cmp TMP0w, #BC_FORL
  |  bne >9
  |  ldrb TMP1w, [PC, #4+OFS_RA]	// Numeric-for base slot.
  |  add TMP2w, TMP1w, #3		// Visible index slot.
  |
  |  ldrb TMP0w, [PC, #8+OFS_OP]
  |  cmp TMP0w, #BC_MODVN
  |  bne >9
  |  ldrb TMP0w, [PC, #8+OFS_RA]
  |  cmp TMP0w, TMP1w
  |  bne >9
  |  ldrh TMP3w, [PC, #8+OFS_RD]
  |  lsr TMP0w, TMP3w, #8
  |  cmp TMP0w, CARG5w
  |  bne >9
  |  and TMP3w, TMP3w, #255
  |  ldr TMP3, [KBASE, TMP3, lsl #3]
  |  cmp TISNUMhi, TMP3, lsr #32
  |  beq >1
  |  bhi >2
  |  b >9
|2:
  |  fmov FARG2, TMP3
  |  fcvtzs TMP3, FARG2
|1:
  |  mov TMP0w, #0x4240
  |  movk TMP0w, #0x000f, lsl #16
  |  cmp TMP3w, TMP0w
  |  bne >9
  |  ldrb TMP0w, [PC, #12+OFS_OP]
  |  cmp TMP0w, #BC_RET1
  |  bne >9
  |  ldrb TMP0w, [PC, #12+OFS_RA]
  |  cmp TMP0w, TMP1w
  |  bne >9
  |
  |  ldrb TMP0w, [PC, #-8+OFS_OP]
  |  cmp TMP0w, #BC_JMP
  |  bne >9
  |  ldrb TMP0w, [PC, #-12+OFS_OP]
  |  cmp TMP0w, #BC_ADDVV
  |  bne >9
  |  ldrb TMP0w, [PC, #-12+OFS_RA]
  |  cmp TMP0w, CARG5w
  |  bne >9
  |  ldrh TMP3w, [PC, #-12+OFS_RD]
  |  and TMP0w, TMP3w, #255
  |  cmp TMP0w, CARG5w
  |  beq >1
  |  cmp TMP0w, RAw
  |  bne >9
  |  lsr TMP0w, TMP3w, #8
  |  cmp TMP0w, CARG5w
  |  bne >9
  |  b >2
|1:
  |  lsr TMP0w, TMP3w, #8
  |  cmp TMP0w, RAw
  |  bne >9
|2:
  |  ldrb TMP0w, [PC, #-16+OFS_OP]
  |  cmp TMP0w, #BC_MODVN
  |  bne >9
  |  ldrb TMP0w, [PC, #-16+OFS_RA]
  |  cmp TMP0w, RAw
  |  bne >9
  |  ldrh TMP3w, [PC, #-16+OFS_RD]
  |  lsr TMP0w, TMP3w, #8
  |  cmp TMP0w, RBw
  |  bne >9
  |  ldrh TMP0w, [PC, #-4+OFS_RD]
  |  and TMP0w, TMP0w, #255
  |  and TMP3w, TMP3w, #255
  |  cmp TMP0w, TMP3w
  |  bne >9
  |  ldrb TMP0w, [PC, #-20+OFS_OP]
  |  cmp TMP0w, #BC_JMP
  |  bne >9
  |  ldrb TMP0w, [PC, #-24+OFS_OP]
  |  cmp TMP0w, #BC_ISGE
  |  bne >9
  |  ldrb TMP0w, [PC, #-24+OFS_RA]
  |  cmp TMP0w, RAw
  |  bne >9
  |  ldrh TMP0w, [PC, #-24+OFS_RD]
  |  cmp TMP0w, RBw
  |  bne >9
  |
  |  ldrb TMP0w, [PC, #-28+OFS_OP]
  |  cmp TMP0w, #BC_ADDVN
  |  bne >9
  |  ldrb TMP0w, [PC, #-28+OFS_RA]
  |  cmp TMP0w, RAw
  |  bne >9
  |  ldrb CARG4w, [PC, #-28+OFS_RB]	// Base slot.
  |  cmp CARG4w, RAw
  |  beq >9
  |  cmp CARG4w, RBw
  |  beq >9
  |  ldrb TMP0w, [PC, #-28+OFS_RD]
  |  ldr TMP3, [KBASE, TMP0, lsl #3]
  |  cmp TISNUMhi, TMP3, lsr #32
  |  beq >1
  |  bhi >2
  |  b >9
|2:
  |  fmov FARG2, TMP3
  |  fcvtzs TMP3, FARG2
|1:
  |  cmp TMP3w, #1024
  |  bne >9
  |
  |  ldrb TMP0w, [PC, #-32+OFS_OP]
  |  cmp TMP0w, #BC_ADDVV
  |  bne >9
  |  ldrb TMP0w, [PC, #-32+OFS_RA]
  |  cmp TMP0w, RBw
  |  bne >9
  |  ldrh TMP3w, [PC, #-32+OFS_RD]
  |  and TMP0w, TMP3w, #255
  |  lsr TMP3w, TMP3w, #8
  |  cmp TMP0w, CARG4w
  |  bne >3
  |  cmp TMP3w, TMP2w
  |  bne >9
  |  b >4
|3:
  |  cmp TMP3w, CARG4w
  |  bne >9
  |  cmp TMP0w, TMP2w
  |  bne >9
|4:
  |  ldr TMP3, [BASE, CARG4, lsl #3]
  |  cmp TISNUMhi, TMP3, lsr #32
  |  beq >1
  |  bhi >2
  |  asr ITYPE, TMP3, #47
  |  cmn ITYPE, #-LJ_TINT64
  |   and TMP3, TMP3, #LJ_GCVMASK
  |  bne >9
  |  ldr TMP3, INT64:TMP3->i
  |  b >3
|2:
  |  fmov FARG2, TMP3
  |  fcvtzs TMP3, FARG2
|1:
  |  sxtw TMP3, TMP3w
|3:
  |  movz TMP0, #0x0100, lsl #32	// 2^40.
  |  cmp TMP3, TMP0
  |  bne >9
  |
  |  ldr CARG3, [BASE, TMP2, lsl #3]
  |  checkint CARG3, >9
  |  sxtw CARG3, CARG3w		// Current loop index.
  |  cmp CARG3, #1
  |  blt >9
  |  mov TMP0w, #1024
  |  cmp CARG3, TMP0
  |  bgt >9				// This helper starts from the else branch.
  |  add TMP3, TMP3, CARG3
  |  cmp TMP3, CARG1
  |  bne >9
  |
  |  add TMP0, BASE, TMP1, lsl #3
  |  ldr TMP3, [TMP0]
  |  checkint TMP3, >9
  |  cmp TMP3w, CARG3w
  |  bne >9
  |  ldr CARG4, [TMP0, #8]
  |  checkint CARG4, >9
  |  sxtw CARG4, CARG4w		// Loop limit.
  |  cmp CARG3, CARG4
  |  bgt >9
  |  ldr TMP3, [TMP0, #16]
  |  checkint TMP3, >9
  |  cmp TMP3w, #1
  |  bne >9
  |  ldr CARG5, [BASE, CARG5, lsl #3]
  |  checkint CARG5, >9
  |  sxtw CARG5, CARG5w		// Accumulator before the current iteration.
  |
  |  mov CARG1, CARG3		// Current index.
  |  mov CARG2, CARG4		// Loop limit.
  |  mov RCw, #97
  |  udiv TMP0, CARG1, RC
  |  msub TMP1, TMP0, RC, CARG1
  |  add TMP1, TMP1, #36		// (2^40 % 97) + current residue.
