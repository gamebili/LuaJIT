  |  cmp CARG1w, CARG3w
  |  ble <7
  |  cmp CARG2, CARG2, sxtw
  |  bne >9
  |  add_TISNUM TMP0, CARG2
  |  str TMP0, [BASE, CARG5, lsl #3]
