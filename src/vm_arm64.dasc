  |9:
  |  add_TISNUM TMP0, RC
  |  str TMP0, [BASE, RA, lsl #3]
  |  ins_next
  |
  |->vm_tsetv_i64_update:
  |  // CARG2 = GCtab *, TMP1 = tagged boxed int64 key, RA = source slot.
  |   and INT64:CARG4, TMP1, #LJ_GCVMASK
  |  ldr CARG4, INT64:CARG4->i
  |  cmp CARG4, CARG4, sxtw
  |  beq ->vmeta_tsetv		// int32-compatible boxes use integer keys.
  |  ldr TMP1w, TAB:CARG2->hmask
  |   ldr NODE:CARG3, TAB:CARG2->node
  |  mov TMP2w, CARG4w
  |   lsr CARG1, CARG4, #32
  |  eor TMP2w, TMP2w, CARG1w
  |   ror TMP0w, CARG1w, #18
