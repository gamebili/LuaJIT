    |  checkstr TMP0, ->BC_CAT_Z
    |  checkstr TMP1, ->BC_CAT_Z
    |  mov CARG1, L
    |   str PC, SAVE_PC
    |  bl extern lj_meta_cat2str		// (lua_State *L, TValue *top)
    |  ldrb RBw, [PC, #-4+OFS_RB]
    |   ldr BASE, L->base
    |  ldr TMP0, [BASE, RB, lsl #3]
    |  str TMP0, [BASE, RA, lsl #3]	// Copy result to RA.
    |  ins_next
#endif
    |->BC_CAT_Z:
    |  // RA = dst, CARG2 = top-1, CARG3 = left
    |  mov CARG1, L
    |   str PC, SAVE_PC
    |  bl extern lj_meta_cat		// (lua_State *L, TValue *top, int left)
    |  // Returns NULL (finished) or TValue * (metamethod).
    |  ldrb RBw, [PC, #-4+OFS_RB]
    |   ldr BASE, L->base
    |   cbnz CRET1, ->vmeta_binop
    |  ldr TMP0, [BASE, RB, lsl #3]
    |  str TMP0, [BASE, RA, lsl #3]	// Copy result to RA.
    |  ins_next
    break;

  /* -- Lua 5.4 bitwise ops ----------------------------------------------- */

    |.macro load_bitint64_1, target
    |  cmp TISNUMhi, CARG1, lsr #32
    |  beq >1
    |  bhi target
    |  asr ITYPE, CARG1, #47
    |  cmn ITYPE, #-LJ_TINT64
    |   and CARG1, CARG1, #LJ_GCVMASK
    |  bne target
    |  ldr CARG1, INT64:CARG1->i
    |  b >2
    |1:
    |  sxtw CARG1, CARG1w
    |2:
    |.endmacro
    |
    |.macro load_bitint64_2, target
    |  cmp TISNUMhi, CARG2, lsr #32
    |  beq >1
    |  bhi target
    |  asr ITYPE, CARG2, #47
    |  cmn ITYPE, #-LJ_TINT64
    |   and CARG2, CARG2, #LJ_GCVMASK
    |  bne target
    |  ldr CARG2, INT64:CARG2->i
    |  b >2
    |1:
    |  sxtw CARG2, CARG2w
    |2:
    |.endmacro
    |
    |.macro store_bitint64_1
    |  ldr TMP0, [BASE, RA, lsl #3]
    |  asr ITYPE, TMP0, #47
    |  cmn ITYPE, #-LJ_TINT64
     |   and TMP0, TMP0, #LJ_GCVMASK
    |  bne >7
    |  add TMP1, BASE, RA, lsl #3
    |  ldr TMP2, INT64:TMP0->owner
    |  cmp TMP1, TMP2
    |  bne >7
    |  str CARG1, INT64:TMP0->i
    |  ins_next
    |7:
    |  cmp CARG1, CARG1, sxtw
    |  bne >8
    |  mov CARG1w, CARG1w
    |  add_TISNUM CARG1, CARG1
    |  str CARG1, [BASE, RA, lsl #3]
    |  ins_next
    |8:
    |  ldr LFUNC:TMP1, [BASE, FRAME_FUNC]
     |   add CARG2, BASE, RA, lsl #3
    |  and LFUNC:TMP1, TMP1, #LJ_GCVMASK
    |   mov CARG3, CARG1
    |  ldr TMP1, LFUNC:TMP1->pc
    |   str BASE, L->base
    |  ldrb TMP1w, [TMP1, #PC2PROTO(framesize)]
    |   mov CARG1, L
    |  add TMP1, BASE, TMP1, lsl #3
    |   str PC, SAVE_PC
    |  str TMP1, L->top
    |  bl extern lj_obj_setint64	// (lua_State *L, TValue *o, int64_t i)
    |  ldr BASE, L->base
    |  ins_next
    |.endmacro
    |
#if LJ_54
    |.macro fuse_bitint64_next_same_ra
    |  ldr TMP0w, [GL, #GL_J(flags)]
    |  b >9  // Lua 5.4 jit.off integer-fusion disabled: unsound for
    |         // live-local source slots (skips the producer-result store).
    |  ldrb TMP0w, [PC, # OFS_OP]
    |  cmp TMP0w, #BC_BAND
    |  beq >5
    |  cmp TMP0w, #BC_BOR
    |  beq >5
    |  cmp TMP0w, #BC_BXOR
    |  bne >9
    |5:
