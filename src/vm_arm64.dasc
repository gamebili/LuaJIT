#if LJ_54
	    /* Lua 5.4 modulo: integer floor modulo inline; floats (official fmod
	    ** formula), strings and metamethods route to lj_meta_arith().
	    */
	    if (op == BC_MODVV) {
	      |  decode_RB RB, INS
	      |   and RC, RC, #255
	      |  ldr CARG1, [BASE, RB, lsl #3]
	      |  ldr CARG2, [BASE, RC, lsl #3]
	      |  checkint CARG1, >8
	      |  checkint CARG2, >8
	      |  cbz CARG2w, >8
	      |  adr lr, >8
	      |  b ->vm_modvv_dynamic_forl_next
	|8:
	    }
	    |  ins_arithhead
	    |  ins_arithload CARG1, CARG2
    |  load_arithint64_1 >5
    if (op == BC_MODVN) {
      |  cmp TISNUMhi, CARG2, lsr #32
      |  bls >4
      |  fmov FARG2, CARG2
      |  fcmp FARG2, #0.0
      |  bls >4				// Constant divisor must be positive.
      |  fcvtzs TMP1, FARG2
      |  cmp TMP1, TMP1, sxtw
      |  bne >4				// Keep the result in tagged-int range.
	      |  scvtf d2, TMP1
	      |  fcmp d2, FARG2
	      |  bne >4				// Constant must be an exact integer.
	      |  cmp TMP1, #97
	      |  bne >8
	      |  mov CARG2, TMP1
	      |  adr lr, >8
	      |  b ->vm_modvn_i64_add_compare_forl_next
	|8:
	      |  mov TMP1, CARG2
	      |  sub TMP0, TMP1, #1
	      |  tst TMP0, TMP1
	      |  bne >1
      |  and CARG3, CARG1, TMP0
      |  b >3
      |1:
      |  cmp CARG1, CARG1, sxtw
      |  bne >2
      |  sdiv CARG3w, CARG1w, TMP1w
      |  msub CARG3w, CARG3w, TMP1w, CARG1w
      |  cbz CARG3w, >3
      |  tbz CARG3w, #31, >3
      |  add CARG3w, CARG3w, TMP1w
      |  b >3
      |2:
      |  sdiv CARG3, CARG1, TMP1
      |  msub CARG3, CARG3, TMP1, CARG1
      |  cbz CARG3, >3
      |  tbz CARG3, #63, >3
      |  add CARG3, CARG3, TMP1		// Floor modulo for negative dividends.
|3:
      |  ldr CARG1w, [GL, #GL_J(flags)]
      |  tbnz CARG1w, #0, >3		// JIT_F_ON: preserve JIT-on behavior.
      |  ldrb TMP0w, [PC, # OFS_OP]
      |  cmp TMP0w, #BC_KSHORT
      |  bne >3
      |  ldrb TMP0w, [PC, #4+OFS_OP]
      |  cmp TMP0w, #BC_ISLT
      |  beq >2
      |  cmp TMP0w, #BC_ISGE
      |  beq >2
      |  cmp TMP0w, #BC_ISLE
      |  beq >2
      |  cmp TMP0w, #BC_ISGT
      |  bne >3
      |2:
      |  ldrb TMP2w, [PC, #8+OFS_OP]
      |  cmp TMP2w, #BC_JMP
      |  bne >3
      |  ldrb TMP1w, [PC, # OFS_RA]	// KSHORT slot.
      |  ldrh CARG2w, [PC, # OFS_RD]
      |  sxth CARG2w, CARG2w
      |  ldrb CARG4w, [PC, #4+OFS_RA]
      |  ldrh TMP2w, [PC, #4+OFS_RD]
      |  cmp CARG4w, RAw
      |  bne >1
      |  cmp TMP2w, TMP1w
      |  bne >3
      |  mov CARG1w, wzr		// Modulo result is compare lhs.
      |  b >2
      |1:
      |  cmp CARG4w, TMP1w
      |  bne >3
      |  cmp TMP2w, RAw
      |  bne >3
      |  mov CARG1w, #1			// KSHORT literal is compare lhs.
      |2:
      |  add_TISNUM TMP2, CARG2
      |  str TMP2, [BASE, TMP1, lsl #3]
	      |  sxtw CARG2, CARG2w
	      |  mov TMP2w, CARG3w
	      |  add_TISNUM TMP2, TMP2
	      |  str TMP2, [BASE, RA, lsl #3]
	      |  ldrh RBw, [PC, #8+OFS_RD]
	      |  add CARG4, PC, #12
	      |  add RB, CARG4, RB, lsl #2
      |  sub RB, RB, #0x20000
      |  cbnz CARG1w, >7
      |  cmp TMP0w, #BC_ISLT
      |  beq >6
      |  cmp TMP0w, #BC_ISGE
      |  beq >7
      |  cmp TMP0w, #BC_ISLE
      |  beq >8
      |  b >9
      |7:
      |  cmp TMP0w, #BC_ISLT
      |  beq >9
      |  cmp TMP0w, #BC_ISGE
      |  beq >8
      |  cmp TMP0w, #BC_ISLE
      |  beq >7
      |  b >6
      |6:
      |  cmp CARG3, CARG2
      |  csel PC, RB, CARG4, lt
      |  ins_next
      |7:
      |  cmp CARG3, CARG2
      |  csel PC, RB, CARG4, ge
      |  ins_next
      |8:
      |  cmp CARG3, CARG2
      |  csel PC, RB, CARG4, le
      |  ins_next
      |9:
      |  cmp CARG3, CARG2
      |  csel PC, RB, CARG4, gt
      |  ins_next
      |3:
      |  mov CARG3w, CARG3w
      |  add_TISNUM TMP0, CARG3
      |  str TMP0, [BASE, RA, lsl #3]
      |  ins_next
      |4:
    }
    |  load_arithint64_2 >5
    |  ins_arithfallback ins_arithcheck_nzdiv64	// n%0: C error path.
    if (op == BC_MODVN) {
      |  adr lr, >8
      |  b ->vm_modvn_forl_next
|8:
    }
    |  cmn CARG2, #1			// a % -1 == 0: skip the division.
    |  beq >7
    |  sdiv CARG3, CARG1, CARG2
    |  msub CARG3, CARG3, CARG2, CARG1
    |  cbz CARG3, >6
    |  eor TMP0, CARG3, CARG2		// Floor adjust toward sign of divisor.
    |  tbz TMP0, #63, >6
    |  add CARG3, CARG3, CARG2
    |6:
    |  mov CARG1, CARG3
    |  store_arithint64_1
    |7:
    |  mov CARG3, #0
    |  b <6
    |5:  // FP modulo fast path; strings and metamethods use the C path.
    |  ins_arithload CARG1, CARG2
    |  checknum CARG1, >8
    |  checknum CARG2, >8
    |  fmov FARG1, CARG1
    |  fmov FARG2, CARG2
    |  movz TMP0, #0x4330, lsl #48	// 2^52.
    |  cmp CARG1, TMP0			// Non-negative finite and < 2^52?
    |  bhs >7
    |  fcmp FARG2, #0.0
    |  bls >7				// Divisor must be positive and ordered.
    |  fcvtzs TMP1, FARG2
    |  scvtf d2, TMP1
    |  fcmp d2, FARG2
    |  bne >7				// Divisor must be an integer.
    |  ins_arithmod FARG1, FARG1, FARG2
    |  str FARG1, [BASE, RA, lsl #3]
    |  ins_next
    |7:
    |  bl extern lj_vm_lua54fmod
    |  str FARG1, [BASE, RA, lsl #3]
    |  ins_next
    |8:
    |  ins_arithfallback b
