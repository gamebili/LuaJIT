  |  add TMP1, BASE, RB, lsl #3
  |  ldr CARG1, [BASE, CARG4, lsl #3]
  |  checkint CARG1, >9
  |  sxtw CARG1, CARG1w
  |  ldr CARG3, [TMP1, #8]
  |  checkint CARG3, >9
  |  sxtw CARG3, CARG3w
  |  ldr TMP2, [TMP1, #16]
  |  checkint TMP2, >9
  |  cmp TMP2w, #1
  |  bne >9
  |  cmp CARG1w, CARG3w
  |  bgt >9
  |  ldr CARG2, [BASE, CARG5, lsl #3]
  |  checkint CARG2, >9
